<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Painel' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
  <div class="page-layout">

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'painel' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Painel da Coordenação</h1>
            <span>Retenção e Resgate — SENAI Ji-Paraná</span>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando dados...</div>

        <div id="conteudoPainel" class="d-none">

          <div id="avisoSemImportacao" class="alert alert-warning d-none">
            Nenhum aluno importado ainda — os números abaixo só ficam completos depois que a
            planilha da secretaria for enviada em <a href="/importar-telefones">Importar contatos</a>.
          </div>

          <div class="row">
            <div class="col-xxl-3 col-md-6">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Alunos ativos</h6>
                    <h2 class="mb-0" id="kpiAlunosAtivos">—</h2>
                  </div>
                  <div class="avatar bg-success bg-opacity-10 shadow-info rounded-circle avatar-xl text-success mb-0 mx-auto">
                    <i class="bi bi-people-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <span id="rodapeAtivos">Matriculados na planilha da secretaria</span>
                </div>
              </div>
            </div>

            <div class="col-xxl-3 col-md-6">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Alunos em risco</h6>
                    <h2 class="mb-0" id="kpiAlunosRisco">—</h2>
                  </div>
                  <div class="avatar bg-danger bg-opacity-10 shadow-info rounded-circle avatar-xl text-danger mb-0 mx-auto">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <a href="/risco"><span id="rodapeRisco">Faltando há dias seguidos</span> — ver alunos <i class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>

            <div class="col-xxl-3 col-md-6">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Sem telefone</h6>
                    <h2 class="mb-0" id="kpiSemTelefone">—</h2>
                  </div>
                  <div class="avatar bg-warning bg-opacity-10 shadow-info rounded-circle avatar-xl text-warning mb-0 mx-auto">
                    <i class="bi bi-telephone-x-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <a href="/importar-telefones">Não dá pra contatar — importar planilha <i class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>

            <div class="col-xxl-3 col-md-6">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Critério de risco</h6>
                    <h2 class="mb-0" id="kpiCriterio">—</h2>
                  </div>
                  <div class="avatar bg-info bg-opacity-10 shadow-info rounded-circle avatar-xl text-info mb-0 mx-auto">
                    <i class="bi bi-shield-exclamation"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <span>Dias de aula seguidos com falta para entrar na lista</span>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    // Abaixo de 1200px o menu fica escondido (abre por cima do conteúdo);
    // acima disso ele fica sempre visível, e o botão só encolhe pra modo mini (ícones).
    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    // Tema claro/escuro — preferência salva no navegador
    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    async function chamarApi(caminho) {
      const resposta = await fetch(caminho, { headers: { Authorization: 'Bearer ' + token } });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      return resposta.json();
    }

    function formatarData(dataIso) {
      return new Date(dataIso).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    async function carregarPainel() {
      try {
        const resumo = (await chamarApi('/alunos/resumo')).dados;

        document.getElementById('kpiAlunosAtivos').textContent = resumo.ativos;
        document.getElementById('kpiAlunosRisco').textContent = resumo.emRisco;
        document.getElementById('kpiSemTelefone').textContent = resumo.semTelefone;
        document.getElementById('kpiCriterio').textContent = resumo.criterioRisco;

        // Sem aluno importado, "0 ativos" parece um dado e não é — é a ausência
        // dele. O aviso manda a coordenação pra tela de importação.
        if (resumo.ativos === 0) {
          document.getElementById('avisoSemImportacao').classList.remove('d-none');
        }

        document.getElementById('rodapeAtivos').textContent = resumo.importadosEm
          ? `Matriculados na planilha da secretaria — importada em ${formatarData(resumo.importadosEm)}`
          : 'Matriculados na planilha da secretaria';

        // A porcentagem é o que dá escala ao número: 8 em risco é muito diferente
        // em uma escola de 30 alunos e em uma de 400.
        const percentual = resumo.ativos > 0 ? Math.round((resumo.emRisco / resumo.ativos) * 100) : null;
        document.getElementById('rodapeRisco').textContent = percentual !== null
          ? `${percentual}% dos alunos ativos`
          : `${resumo.criterioRisco} dias de aula seguidos sem vir`;

        document.getElementById('statusCarregamento').classList.add('d-none');
        document.getElementById('conteudoPainel').classList.remove('d-none');

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          const status = document.getElementById('statusCarregamento');
          status.className = 'alert alert-warning';
          status.textContent = 'Não foi possível carregar os dados do painel agora.';
        }
      }
    }

    carregarPainel();
  </script>
</body>

</html>