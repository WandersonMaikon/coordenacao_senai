<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Painel' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
  <div class="page-layout">

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'painel' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Painel da Coordenação</h1>
            <span>Retenção e Resgate — SENAI Ji-Paraná</span>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <div class="row g-3 align-items-end">
              <div class="col-md-6 col-lg-5">
                <label class="form-label" for="filtroTurma">Turma</label>
                <select class="form-select" id="filtroTurma">
                  <option value="">Todas as turmas</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando dados...</div>

        <div id="conteudoPainel" class="d-none">

          <div id="avisoSemImportacao" class="alert alert-warning d-none">
            <span id="textoAviso"></span><a href="/importar-telefones">Importar contatos</a>.
          </div>

          <%# São 4 cards com o "Sem telefone" desativado; volte pra row-cols-xxl-5
              se ele for reativado, senão sobra uma coluna vazia na linha. %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-4 g-3">
            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Matriculados</h6>
                    <h2 class="mb-0" id="kpiMatriculados">—</h2>
                  </div>
                  <div class="avatar bg-primary bg-opacity-10 shadow-info rounded-circle avatar-xl text-primary mb-0 mx-auto">
                    <i class="bi bi-mortarboard-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <span id="rodapeMatriculados">Total da planilha da secretaria</span>
                </div>
              </div>
            </div>

            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Alunos ativos</h6>
                    <h2 class="mb-0" id="kpiAlunosAtivos">—</h2>
                  </div>
                  <div class="avatar bg-success bg-opacity-10 shadow-info rounded-circle avatar-xl text-success mb-0 mx-auto">
                    <i class="bi bi-people-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <span id="rodapeAtivos">Matriculados na planilha da secretaria</span>
                </div>
              </div>
            </div>

            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1" id="tituloRisco">Alunos em risco</h6>
                    <h2 class="mb-0" id="kpiAlunosRisco">—</h2>
                  </div>
                  <div class="avatar bg-danger bg-opacity-10 shadow-info rounded-circle avatar-xl text-danger mb-0 mx-auto">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <a href="/risco"><span id="rodapeRisco">Faltando há dias seguidos</span> — ver alunos <i class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>

            <%# Card "Sem telefone" desativado a pedido da coordenação. Pra trazer de
                volta: apague a linha de abertura deste comentário EJS e a de
                fechamento logo abaixo do card, descomente a linha do kpiSemTelefone
                no script e volte a grade pra row-cols-xxl-5. O campo `semTelefone`
                continua vindo em GET /alunos/resumo, nada muda no backend.

            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Sem telefone</h6>
                    <h2 class="mb-0" id="kpiSemTelefone">—</h2>
                  </div>
                  <div class="avatar bg-warning bg-opacity-10 shadow-info rounded-circle avatar-xl text-warning mb-0 mx-auto">
                    <i class="bi bi-telephone-x-fill"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <a href="/importar-telefones">Não dá pra contatar — importar planilha <i class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>
            %>

            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex flex-column mb-3">
                    <h6 class="text-body text-uppercase text-2xs mb-1">Alunos recuperados</h6>
                    <h2 class="mb-0" id="kpiRecuperados">—</h2>
                  </div>
                  <div class="avatar bg-info bg-opacity-10 shadow-info rounded-circle avatar-xl text-info mb-0 mx-auto">
                    <i class="bi bi-arrow-counterclockwise"></i>
                  </div>
                </div>
                <div class="card-footer border-0">
                  <span id="rodapeRecuperados">Sumiram, voltaram e continuam vindo</span>
                </div>
              </div>
            </div>
          </div>

          <div class="row mt-4">
            <div class="col-12">
              <div class="card">
                <div class="card-body">
                  <h5 class="mb-1">Motivos das faltas</h5>
                  <p class="text-body-secondary mb-4" id="subtituloMotivos">
                    A partir dos contatos registrados pela coordenação na tela de Alunos em risco
                  </p>

                  <div id="semMotivos" class="alert alert-info d-none mb-0">
                    Nenhum contato com motivo registrado ainda. O motivo é preenchido ao registrar
                    um contato em <a href="/risco">Alunos em risco</a> — é ele que responde
                    <em>por que</em> os alunos estão faltando, não só quantos faltaram.
                  </div>

                  <div id="conteudoMotivos" class="row g-4 align-items-center">
                    <div class="col-lg-5">
                      <!-- Altura fixa: sem isso o Chart.js cresce a cada redimensionamento -->
                      <div style="position: relative; height: 280px;">
                        <canvas id="graficoMotivos"></canvas>
                      </div>
                    </div>
                    <div class="col-lg-7">
                      <!-- A legenda em tabela é a leitura acessível do gráfico: quem não
                           distingue as cores (ou imprime em preto e branco) lê os números. -->
                      <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                          <thead>
                            <tr>
                              <th>Motivo</th>
                              <th class="text-end">Contatos</th>
                              <th class="text-end">%</th>
                            </tr>
                          </thead>
                          <tbody id="tabelaMotivos"></tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="/js/turmas.js"></script>
  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    // Abaixo de 1200px o menu fica escondido (abre por cima do conteúdo);
    // acima disso ele fica sempre visível, e o botão só encolhe pra modo mini (ícones).
    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    // Tema claro/escuro — preferência salva no navegador
    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
      // O gráfico não reage sozinho à troca de tema: as cores das fatias e a borda
      // que as separa são passos escolhidos pra cada fundo, então redesenhamos.
      carregarMotivos(document.getElementById('filtroTurma').value);
    });

    async function chamarApi(caminho) {
      const resposta = await fetch(caminho, { headers: { Authorization: 'Bearer ' + token } });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      return resposta.json();
    }

    function formatarData(dataIso) {
      return new Date(dataIso).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    // Mesmos rótulos do <select> de motivo da tela /risco. Se um dia a lista de lá
    // mudar, esta precisa acompanhar — o gráfico cai no código cru do motivo pra
    // qualquer valor que não estiver aqui, então nada some da contagem.
    const MOTIVOS = {
      transporte: 'Transporte',
      trabalho: 'Trabalho',
      saude_atestado: 'Saúde — com atestado',
      saude_sem_atestado: 'Saúde — sem atestado',
      saude_mental: 'Saúde mental',
      financeiro: 'Financeiro',
      desmotivacao_curso: 'Desmotivação com o curso',
      problema_familiar: 'Problema familiar',
      outro: 'Outro / não informado'
    };

    // Paleta categórica em ordem fixa: a fatia recebe a cor pela posição, e a
    // ordem nunca é reciclada. Os tons escuros não são o mesmo hex clareado —
    // são passos próprios, escolhidos pra manter contraste no fundo escuro.
    const CORES_MOTIVO = {
      claro: ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300'],
      escuro: ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300']
    };

    // "Outros" não é um motivo, é o resto — vai de cinza pra não competir com as
    // categorias de verdade, e os motivos que caem nele usam o mesmo cinza na
    // tabela, deixando visível que estão somados naquela fatia.
    const COR_OUTROS = { claro: '#8f8f86', escuro: '#7c7c73' };

    // Pizza só se lê de relance até ~6 fatias; acima disso as menores viram
    // lasquinhas indistinguíveis. As 5 maiores ficam e o resto soma em "Outros
    // motivos" — a tabela ao lado continua mostrando tudo separado.
    const MAX_FATIAS = 6;

    function prepararFatias(dados) {
      if (dados.length <= MAX_FATIAS) {
        return dados.map((item) => ({ rotulo: MOTIVOS[item.motivo] || item.motivo, total: item.total }));
      }

      const principais = dados.slice(0, MAX_FATIAS - 1)
        .map((item) => ({ rotulo: MOTIVOS[item.motivo] || item.motivo, total: item.total }));
      const resto = dados.slice(MAX_FATIAS - 1).reduce((soma, item) => soma + item.total, 0);
      return [...principais, { rotulo: `Outros motivos (${dados.length - MAX_FATIAS + 1})`, total: resto }];
    }

    let graficoMotivos = null;

    function desenharMotivos(dados, total) {
      const semDados = document.getElementById('semMotivos');
      const conteudo = document.getElementById('conteudoMotivos');

      semDados.classList.toggle('d-none', total > 0);
      conteudo.classList.toggle('d-none', total === 0);
      if (total === 0) {
        if (graficoMotivos) { graficoMotivos.destroy(); graficoMotivos = null; }
        document.getElementById('tabelaMotivos').innerHTML = '';
        return;
      }

      const fatias = prepararFatias(dados);
      const escuro = document.documentElement.getAttribute('data-bs-theme') === 'dark';
      const paleta = escuro ? CORES_MOTIVO.escuro : CORES_MOTIVO.claro;
      const corFundo = escuro ? '#212529' : '#ffffff';

      // Quando houve agrupamento, a última fatia é o "Outros" e recebe o cinza.
      const indiceOutros = dados.length > MAX_FATIAS ? fatias.length - 1 : -1;
      const corOutros = escuro ? COR_OUTROS.escuro : COR_OUTROS.claro;
      const cores = fatias.map((fatia, i) => (i === indiceOutros ? corOutros : paleta[i]));

      // A tabela repete os números do gráfico: é a leitura de quem não distingue
      // as cores, e onde os motivos agrupados em "Outros" aparecem um a um.
      document.getElementById('tabelaMotivos').innerHTML = dados.map((item) => {
        const indice = fatias.findIndex((fatia) => fatia.rotulo === (MOTIVOS[item.motivo] || item.motivo));
        const cor = indice >= 0 ? cores[indice] : corOutros;
        const percentual = Math.round((item.total / total) * 100);
        return `
          <tr>
            <td>
              <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${cor};margin-right:8px"></span>
              ${MOTIVOS[item.motivo] || item.motivo}
            </td>
            <td class="text-end">${item.total}</td>
            <td class="text-end">${percentual}%</td>
          </tr>
        `;
      }).join('');

      if (graficoMotivos) graficoMotivos.destroy();

      graficoMotivos = new Chart(document.getElementById('graficoMotivos'), {
        type: 'doughnut',
        data: {
          labels: fatias.map((fatia) => fatia.rotulo),
          datasets: [{
            data: fatias.map((fatia) => fatia.total),
            backgroundColor: cores,
            // A borda na cor do fundo é o respiro de 2px entre as fatias: sem ela,
            // duas cores vizinhas encostam e a divisa some.
            borderColor: corFundo,
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          // A legenda do Chart.js seria uma terceira cópia dos mesmos rótulos —
          // a tabela ao lado já cumpre esse papel, e melhor.
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (contexto) => {
                  const percentual = Math.round((contexto.parsed / total) * 100);
                  return ` ${contexto.label}: ${contexto.parsed} (${percentual}%)`;
                }
              }
            }
          }
        }
      });
    }

    async function carregarMotivos(turma) {
      try {
        const resposta = await chamarApi(`/contatos/motivos${turma ? `?turma=${encodeURIComponent(turma)}` : ''}`);
        desenharMotivos(resposta.dados || [], resposta.total || 0);
        document.getElementById('subtituloMotivos').textContent = turma
          ? `${resposta.total} contato(s) registrado(s) com alunos desta turma`
          : `${resposta.total} contato(s) registrado(s) pela coordenação`;
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          console.error('Não foi possível carregar os motivos das faltas:', erro);
        }
      }
    }

    async function carregarPainel(turma) {
      const statusEl = document.getElementById('statusCarregamento');
      statusEl.className = 'alert alert-info';
      statusEl.textContent = 'Carregando dados...';
      statusEl.classList.remove('d-none');

      try {
        const resumo = (await chamarApi(`/alunos/resumo${turma ? `?turma=${encodeURIComponent(turma)}` : ''}`)).dados;

        document.getElementById('kpiMatriculados').textContent = resumo.matriculados;
        document.getElementById('kpiAlunosAtivos').textContent = resumo.ativos;
        document.getElementById('kpiAlunosRisco').textContent = resumo.emRisco;
        // Card "Sem telefone" desativado — ver o comentário no HTML acima.
        // document.getElementById('kpiSemTelefone').textContent = resumo.semTelefone;
        document.getElementById('kpiRecuperados').textContent = resumo.recuperados;

        // Sem aluno importado, "0 ativos" parece um dado e não é — é a ausência
        // dele. O aviso manda a coordenação pra tela de importação. Com filtro de
        // turma ligado, o motivo é outro: a planilha daquela turma não foi enviada.
        // A régua é `matriculados`, não `ativos`: uma turma inteira em risco tem
        // zero ativos com a planilha importada certinho, e isso não é falta de dado.
        const aviso = document.getElementById('avisoSemImportacao');
        aviso.classList.toggle('d-none', resumo.matriculados !== 0);
        document.getElementById('textoAviso').textContent = turma
          ? 'Nenhum aluno desta turma foi importado ainda — envie a planilha dela em '
          : 'Nenhum aluno importado ainda — os números abaixo só ficam completos depois que a planilha da secretaria for enviada em ';

        // A data da planilha vive no card de matriculados, que é o número que vem
        // dela — os outros três são calculados a partir dos lançamentos.
        document.getElementById('rodapeMatriculados').textContent = resumo.importadosEm
          ? `Total da planilha da secretaria — importada em ${formatarData(resumo.importadosEm)}`
          : 'Total da planilha da secretaria';

        // Os dois percentuais usam o total de matriculados como denominador e,
        // juntos, fecham a conta da turma: X% vindo + Y% em risco.
        const percentualAtivos = resumo.matriculados > 0 ? Math.round((resumo.ativos / resumo.matriculados) * 100) : null;
        document.getElementById('rodapeAtivos').textContent = percentualAtivos !== null
          ? `Vindo às aulas — ${percentualAtivos}% dos matriculados`
          : 'Vindo às aulas';

        const percentual = resumo.matriculados > 0 ? Math.round((resumo.emRisco / resumo.matriculados) * 100) : null;
        document.getElementById('rodapeRisco').textContent = percentual !== null
          ? `${percentual}% dos matriculados`
          : `${resumo.criterioRisco} dias de aula seguidos sem vir`;

        // O critério some da tela quando vira um card só de número, mas ainda
        // precisa estar ao alcance de quem pergunta "risco a partir de quando?".
        document.getElementById('tituloRisco').title =
          `${resumo.criterioRisco}+ dias de aula seguidos com falta, sem nenhuma presença no meio`;

        // O rodapé só cita o contato quando houve algum: "0 após contato" ao lado
        // de um número positivo daria a impressão errada de que o trabalho da
        // coordenação não funcionou, quando pode ser que nem tenha havido contato.
        document.getElementById('rodapeRecuperados').textContent = resumo.recuperadosAposContato > 0
          ? `Voltaram após sumir ${resumo.criterioRecuperado}+ dias de aula — ${resumo.recuperadosAposContato} após contato da coordenação`
          : `Voltaram após sumir ${resumo.criterioRecuperado}+ dias de aula e continuam vindo`;

        statusEl.classList.add('d-none');
        document.getElementById('conteudoPainel').classList.remove('d-none');

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'alert alert-warning';
          statusEl.textContent = 'Não foi possível carregar os dados do painel agora.';
        }
      }
    }

    const filtroTurma = document.getElementById('filtroTurma');
    filtroTurma.addEventListener('change', () => {
      carregarPainel(filtroTurma.value);
      carregarMotivos(filtroTurma.value);
    });

    preencherSelectTurmas(filtroTurma, chamarApi);
    carregarPainel('');
    carregarMotivos('');
  </script>
</body>

</html>