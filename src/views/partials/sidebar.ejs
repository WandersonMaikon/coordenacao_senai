<style>
  /* O tema desenha a setinha do submenu num ::after com a fonte
     "uicons-regular-straight", que não veio junto com o CSS — aparecia um
     quadrado vazio. Trocamos pelo chevron do Bootstrap Icons, que as páginas já
     carregam, mantendo o giro de 90° quando o submenu abre. */
  .app-navbar .menu-arrow > .menu-link::after {
    display: none;
  }
  .app-navbar .menu-arrow > .menu-link > .menu-seta {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    margin-right: 0;
    font-size: 12px;
    color: inherit;
    transition: 0.2s transform linear;
  }
  .app-navbar .menu-arrow > .menu-link.open > .menu-seta {
    transform: translateY(-50%) rotate(90deg);
  }
  [data-app-sidebar=mini] .app-menubar .menu-seta {
    display: none;
  }
</style>

<aside class="app-menubar" id="menubar">
  <div class="app-navbar-brand">
    <a class="navbar-brand-logo" href="/painel">
      <img src="/images/logo.svg" alt="logo">
    </a>
    <a class="navbar-brand-mini" href="/painel">
      <img src="/images/logo-text-white.svg" alt="logo">
    </a>
  </div>
  <nav class="app-navbar" data-simplebar>
    <ul class="menubar">
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'painel' ? 'active' : '' %>" href="/painel">
          <i class="bi bi-grid-1x2-fill"></i>
          <span class="menu-label">Painel</span>
        </a>
      </li>
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'faltas' ? 'active' : '' %>" href="/faltas">
          <i class="bi bi-calendar-x-fill"></i>
          <span class="menu-label">Faltas</span>
        </a>
      </li>
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'risco' ? 'active' : '' %>" href="/risco">
          <i class="bi bi-person-lines-fill"></i>
          <span class="menu-label">Alunos em risco</span>
        </a>
      </li>
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'contatar' ? 'active' : '' %>" href="/contatar" style="display: flex; align-items: center;">
          <i class="bi bi-telephone-outbound-fill"></i>
          <span class="menu-label text-nowrap" style="flex: 1; min-width: 0;">Precisam de contato</span>
          <span id="contadorContatar" class="badge rounded-pill flex-shrink-0 ms-2" hidden></span>
        </a>
      </li>
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'recuperado' ? 'active' : '' %>" href="/recuperado">
          <i class="bi bi-person-check-fill"></i>
          <span class="menu-label">Recuperados</span>
        </a>
      </li>
      <li class="menu-item">
        <a class="menu-link <%= paginaAtual === 'whatsapp' ? 'active' : '' %>" href="/whatsapp">
          <i class="bi bi-whatsapp"></i>
          <span class="menu-label">WhatsApp</span>
        </a>
      </li>
      <li class="menu-item menu-arrow <%= ['telefones', 'importar-telefones'].includes(paginaAtual) ? 'open' : '' %>">
        <a class="menu-link <%= ['telefones', 'importar-telefones'].includes(paginaAtual) ? 'open' : '' %>" href="javascript:void(0);">
          <i class="bi bi-telephone-fill"></i>
          <span class="menu-label">Contatos</span>
          <i class="bi bi-chevron-right menu-seta"></i>
        </a>
        <ul class="menu-inner">
          <li class="menu-item">
            <a class="menu-link <%= paginaAtual === 'telefones' ? 'active' : '' %>" href="/telefones">
              <span class="menu-label">Telefones dos alunos</span>
            </a>
          </li>
          <li class="menu-item">
            <a class="menu-link <%= paginaAtual === 'importar-telefones' ? 'active' : '' %>" href="/importar-telefones">
              <span class="menu-label">Importar planilha</span>
            </a>
          </li>
        </ul>
      </li>
      <li class="menu-item" id="menuUsuarios">
        <a class="menu-link <%= paginaAtual === 'usuarios' ? 'active' : '' %>" href="/usuarios">
          <i class="bi bi-people-fill"></i>
          <span class="menu-label">Usuários</span>
        </a>
      </li>
    </ul>
  </nav>
  <div class="app-footer">
    <a href="javascript:void(0);" id="btnSairMenu" class="btn btn-outline-white waves-effect btn-app-nav w-100">
      <i class="bi bi-box-arrow-right"></i>
      <span class="nav-text">Sair</span>
    </a>
  </div>
</aside>

<script>
  // Item "Usuários" só aparece pro admin — o token carrega esse flag desde o login
  (function () {
    const tokenSidebar = localStorage.getItem('coor360_token');
    if (!tokenSidebar) return;
    try {
      const payload = JSON.parse(atob(tokenSidebar.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
      if (!payload.admin) {
        document.getElementById('menuUsuarios').remove();
      }
    } catch (erro) {
      // token inválido — as próprias chamadas fetch() da página vão redirecionar pro /login
    }
  })();

  // Contador do "Precisam de contato": quantos alunos entraram na lista desde a
  // última vez que ESTE usuário abriu a /contatar — visto uma vez, some, e volta
  // quando chega aluno novo. Vermelho se algum dos novos é urgente (desistência,
  // delicado, pediu ajuda, promessa quebrada). O "já vi" fica no navegador
  // (localStorage, por usuário). Falha aqui fica calada — é só um aviso.
  (function () {
    const tokenSidebar = localStorage.getItem('coor360_token');
    const contador = document.getElementById('contadorContatar');
    if (!tokenSidebar || !contador) return;
    let chave;
    try {
      const payload = JSON.parse(atob(tokenSidebar.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
      chave = `coor360_contatar_vistos_${payload.usuario}`;
    } catch (erro) {
      return;
    }
    const lerVistos = () => {
      try { return new Set(JSON.parse(localStorage.getItem(chave) || '[]')); } catch (erro) { return new Set(); }
    };
    const naContatar = <%- JSON.stringify(paginaAtual === 'contatar') %>;

    fetch('/contatos/pendentes/total', { headers: { Authorization: 'Bearer ' + tokenSidebar } })
      .then((r) => (r.ok ? r.json() : null))
      .then((r) => {
        if (!r || r.status !== 'ok' || !Array.isArray(r.matriculas)) return;
        if (naContatar) {
          // Abriu a lista: tudo o que está nela agora conta como visto.
          try { localStorage.setItem(chave, JSON.stringify(r.matriculas)); } catch (erro) { /* sem armazenamento: o contador só não zera */ }
          return;
        }
        const vistos = lerVistos();
        const novos = r.matriculas.filter((m) => !vistos.has(m));
        if (novos.length === 0) return;
        const urgentes = novos.filter((m) => r.urgentes.includes(m)).length;
        contador.textContent = novos.length;
        contador.className = `badge rounded-pill flex-shrink-0 ms-2 ${urgentes ? 'bg-danger' : 'bg-secondary'}`;
        contador.title = `${novos.length} aluno(s) novo(s) na lista${urgentes ? `, ${urgentes} urgente(s)` : ''}`;
        contador.hidden = false;
      })
      .catch(() => {});
  })();

  // Abre/fecha os submenus (o CSS do tema já mostra .menu-inner quando o
  // li.menu-item está .open). Fica aqui no partial pra valer em todas as
  // páginas sem repetir no script inline de cada view.
  (function () {
    document.querySelectorAll('.menubar > li.menu-arrow > .menu-link').forEach((link) => {
      link.addEventListener('click', () => {
        link.parentElement.classList.toggle('open');
        link.classList.toggle('open');
      });
    });
  })();
</script>