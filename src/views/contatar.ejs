<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Precisam de contato' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <div class="page-layout">

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'contatar' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Precisam de contato</h1>
            <span>Alunos em risco que o WhatsApp automático não resolve: precisam de uma pessoa — ligação, WhatsApp pessoal ou conversa presencial</span>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <form id="formFiltro" class="row g-3 align-items-end">
              <div class="col-auto">
                <label class="form-label" for="filtroTurma">Turma</label>
                <select class="form-select" id="filtroTurma">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-filter me-1"></i> Filtrar</button>
              </div>
            </form>
            <div class="small text-body-secondary mt-3">
              <i class="bi bi-info-circle me-1"></i>
              O aluno sai desta lista sozinho quando volta a ter presença na chamada, ou quando alguém registra um
              contato como <em>Respondido</em>, <em>Acompanhar</em> ou <em>Recuperado</em>. Tentativa sem sucesso
              (<em>Sem resposta</em>, <em>Não foi possível contatar</em>) mantém o aluno aqui, com a tentativa anotada.
            </div>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando...</div>
        <div id="resumoMotivos" class="d-flex flex-wrap gap-2 mb-3"></div>
        <div id="listaAlunos"></div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="/js/turmas.js"></script>
  <script>
    // Mesma lista de src/config/motivos.js (vem do viewController).
    const LISTA_MOTIVOS = <%- JSON.stringify(motivos) %>;
    const MOTIVOS = Object.fromEntries(LISTA_MOTIVOS.map((m) => [m.chave, m.rotulo]));

    // Mesmos valores do formulário da /risco.
    const CANAIS = { ligacao: 'Ligação', whatsapp: 'WhatsApp', presencial: 'Presencial' };
    const STATUS = {
      respondido: 'Respondido',
      acompanhar: 'Acompanhar',
      recuperado: 'Recuperado',
      sem_resposta: 'Sem resposta',
      nunca_contato: 'Não foi possível contatar'
    };
    const COR_PRIORIDADE = { 1: 'danger', 2: 'danger', 3: 'warning', 4: 'primary', 5: 'secondary', 6: 'secondary' };
    const ENTREGA = { enviada: 'enviada', entregue: 'entregue', lida: 'lida' };

    function dia(dataIso) {
      return new Date(dataIso).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
    }

    // "O robô ainda está cuidando": em que ponto está e quando vira caso de pessoa.
    function etapaDoRobo(robo) {
      if (robo.etapa === 'promessa') {
        return `Prometeu voltar em ${dia(robo.em)} — a próxima chamada confere. Se faltar, entra em "Prometeu voltar e faltou de novo".`;
      }
      const qual = robo.tentativa === 2 ? '2ª mensagem' : '1ª mensagem';
      const partes = [`${qual} enviada em ${dia(robo.enviadaEm)}${ENTREGA[robo.entrega] ? ` (${ENTREGA[robo.entrega]})` : ''}`];
      if (robo.segundaPrevistaEm) partes.push(`2ª mensagem prevista para ${dia(robo.segundaPrevistaEm)}`);
      partes.push(`se não responder, entra em "Não respondeu" em ${dia(robo.entraNaListaEm)}`);
      return partes.join(' · ');
    }

    const token = localStorage.getItem('coor360_token');
    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    // Nome, turma e a resposta do aluno entram via innerHTML.
    function escaparHtml(texto) {
      return String(texto ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function formatarTelefone(telefone) {
      if (!telefone) return '';
      if (telefone.length === 11) return `(${telefone.slice(0, 2)}) ${telefone.slice(2, 7)}-${telefone.slice(7)}`;
      if (telefone.length === 10) return `(${telefone.slice(0, 2)}) ${telefone.slice(2, 6)}-${telefone.slice(6)}`;
      return telefone;
    }

    function formatarDataHora(dataIso) {
      return new Date(dataIso).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    // "há 3 dias" — o quanto o aluno espera, que é o que ordena a lista.
    function haQuanto(dataIso) {
      const dias = Math.floor((Date.now() - new Date(dataIso).getTime()) / 86400000);
      if (dias <= 0) return 'hoje';
      if (dias === 1) return 'há 1 dia';
      return `há ${dias} dias`;
    }

    async function chamarApi(caminho, opcoes = {}) {
      const resposta = await fetch(caminho, {
        ...opcoes,
        headers: {
          Authorization: 'Bearer ' + token,
          ...(opcoes.body ? { 'Content-Type': 'application/json' } : {})
        }
      });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      if (!(resposta.headers.get('content-type') || '').includes('application/json')) {
        throw new Error(`O servidor não respondeu como esperado (HTTP ${resposta.status}). Aguarde alguns segundos e tente de novo.`);
      }
      return resposta.json();
    }

    let alunos = [];
    // Situação escolhida nos botões do topo (null = todas).
    let filtroMotivo = null;
    // "meus" = assumidos por mim; "ninguem" = sem ninguém cuidando; null = todos.
    let filtroResponsavel = null;
    let motivosLista = {};

    // Usuário logado (para "Eu cuido deste aluno"). O token é só lido aqui; quem
    // confere de verdade é o servidor.
    const eu = (() => {
      try { return JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).usuario; } catch (erro) { return null; }
    })();

    // Em quantos dias cada prioridade deveria ser atendida. Passou disso, o
    // tempo de espera aparece em vermelho.
    const PRAZO_DIAS = { 1: 1, 2: 2, 3: 3, 4: 7, 5: 7, 6: Infinity };

    function diasEsperando(dataIso) {
      return Math.floor((Date.now() - new Date(dataIso).getTime()) / 86400000);
    }

    // O formulário já vem preenchido com o que dá para saber sem perguntar a
    // ninguém: com a conversa do robô lida pela IA, canal WhatsApp, resultado
    // "Acompanhar", o resumo na observação e o motivo — este só quando a IA e o
    // dicionário concordam (motivoIa). A pessoa confere e salva; se ligou, troca o canal.
    function formularioContato(indice) {
      const opcoes = (mapa, selecionado) => Object.entries(mapa)
        .map(([valor, rotulo]) => `<option value="${valor}" ${valor === selecionado ? 'selected' : ''}>${escaparHtml(rotulo)}</option>`).join('');
      const aluno = alunos[indice];
      const preenchido = Boolean(aluno.resumoIa);
      return `
        <form class="border-top pt-3 mt-3" data-form-contato="${indice}" hidden>
          ${preenchido ? `<div class="small text-info-emphasis mb-2"><i class="bi bi-robot me-1"></i>Preenchido pela IA a partir da conversa no WhatsApp — confira antes de salvar. Se você ligou para o aluno, troque o canal e a observação.</div>` : ''}
          <div class="row g-2">
            <div class="col-sm-4 col-lg-2">
              <label class="form-label small">Canal</label>
              <select class="form-select form-select-sm" name="canal">${opcoes(CANAIS, preenchido ? 'whatsapp' : 'ligacao')}</select>
            </div>
            <div class="col-sm-4 col-lg-3">
              <label class="form-label small">Resultado</label>
              <select class="form-select form-select-sm" name="status">${opcoes(STATUS, aluno.respondeuRobo ? 'acompanhar' : 'respondido')}</select>
            </div>
            <div class="col-sm-4 col-lg-3">
              <label class="form-label small">Motivo da falta</label>
              <select class="form-select form-select-sm" name="motivo">
                <option value="">Não informado</option>
                ${opcoes(MOTIVOS, aluno.motivoIa || '')}
              </select>
            </div>
            <div class="col-lg-4">
              <label class="form-label small">Observação</label>
              <input type="text" class="form-control form-control-sm" name="observacao" maxlength="1000" placeholder="O que foi conversado" value="${escaparHtml(aluno.resumoIa || '')}">
            </div>
          </div>
          <div class="mt-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary">Salvar contato</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-cancelar="${indice}">Cancelar</button>
          </div>
        </form>`;
    }

    function cartaoAluno(aluno, indice) {
      const cor = COR_PRIORIDADE[aluno.prioridade] || 'secondary';
      const turmas = aluno.turmas.map((t) =>
        `${escaparHtml(nomeTurmaLimpo(t.nomeTurma) || t.codigoTurma)} <span class="text-body-secondary">· ${t.diasSemVir} dia(s) de aula sem vir</span>`).join('<br>');
      const telefone = aluno.telefone
        ? `<a href="tel:+55${aluno.telefone}" class="me-2"><i class="bi bi-telephone-fill me-1"></i>${formatarTelefone(aluno.telefone)}</a>
           <a href="https://wa.me/55${aluno.telefone}" target="_blank" rel="noopener" class="text-success" title="Abrir conversa no WhatsApp"><i class="bi bi-whatsapp"></i></a>`
        : '<span class="text-body-secondary">Sem telefone — procurar presencialmente ou atualizar em <a href="/telefones">Telefones</a></span>';
      const sugestao = aluno.motivoIa
        ? `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1" title="A IA e o dicionário entenderam o mesmo motivo na conversa">${escaparHtml(MOTIVOS[aluno.motivoIa] || aluno.motivoIa)}</span>`
        : '';
      const resumo = aluno.resumoIa
        ? `<div class="small mt-2" style="max-width: 40rem;"><i class="bi bi-robot me-1 text-info"></i><strong>O que a IA entendeu da conversa:</strong> ${escaparHtml(aluno.resumoIa)}</div>`
        : '';
      const etapaRobo = aluno.robo
        ? `<div class="small mt-2 text-body-secondary"><i class="bi bi-robot me-1"></i>${escaparHtml(etapaDoRobo(aluno.robo))}</div>`
        : '';
      const arquivo = aluno.enviouArquivo
        ? `<div class="small mt-2 text-success-emphasis"><i class="bi bi-paperclip me-1"></i>Mandou foto ou documento pelo WhatsApp (pode ser o atestado) — veja no WhatsApp do número do sistema.</div>`
        : '';

      // A conversa inteira com o robô, fechada até alguém clicar.
      const conversa = aluno.conversa && aluno.conversa.length > 1
        ? `<button type="button" class="btn btn-link btn-sm px-0 mt-1" data-conversa="${indice}"><i class="bi bi-chat-dots me-1"></i>Ver a conversa com o robô (${aluno.conversa.length} mensagens)</button>
           <div class="mt-1" data-conversa-corpo="${indice}" hidden style="max-width: 40rem;">
             ${aluno.conversa.map((m) => m.quem === 'aluno'
                ? `<div class="p-2 rounded-3 small mb-1 me-5" style="background: #dcf8c6; color: #111;">${escaparHtml(m.texto)}<div class="text-end" style="font-size: .7rem; opacity: .6;">${formatarDataHora(m.em)}</div></div>`
                : `<div class="p-2 rounded-3 small mb-1 ms-5 bg-body-secondary"><i class="bi bi-robot me-1"></i>${escaparHtml(m.texto)}</div>`).join('')}
           </div>`
        : '';

      // "Eu cuido deste aluno": evita duas pessoas ligando para o mesmo aluno —
      // ou ninguém ligando, achando que outra pessoa já ligou.
      let responsavel;
      if (!aluno.responsavel) {
        responsavel = `<button type="button" class="btn btn-sm btn-outline-secondary" data-assumir="${indice}"><i class="bi bi-person-check me-1"></i>Eu cuido deste aluno</button>`;
      } else if (aluno.responsavel.usuario === eu) {
        responsavel = `<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle"><i class="bi bi-person-check-fill me-1"></i>Você está cuidando</span>
          <button type="button" class="btn btn-link btn-sm" data-soltar="${indice}">soltar</button>`;
      } else {
        responsavel = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-person-fill me-1"></i>${escaparHtml(aluno.responsavel.nome)} está cuidando desde ${formatarDataHora(aluno.responsavel.em)}</span>
          <button type="button" class="btn btn-link btn-sm" data-assumir="${indice}">assumir no lugar</button>`;
      }

      const dias = diasEsperando(aluno.desde);
      const atrasado = dias > (PRAZO_DIAS[aluno.prioridade] || 7);
      const espera = atrasado
        ? `<div class="small text-danger fw-semibold mt-1"><i class="bi bi-alarm me-1"></i>esperando ${haQuanto(aluno.desde)} — passou do prazo</div>`
        : `<div class="small text-body-secondary mt-1">${haQuanto(aluno.desde)} (${formatarDataHora(aluno.desde)})</div>`;
      const tentativa = aluno.ultimaTentativa
        ? `<div class="small text-body-secondary mt-2"><i class="bi bi-arrow-repeat me-1"></i>Última tentativa: ${formatarDataHora(aluno.ultimaTentativa.em)} por ${escaparHtml(aluno.ultimaTentativa.por || '—')} (${escaparHtml(CANAIS[aluno.ultimaTentativa.canal] || aluno.ultimaTentativa.canal || '')}) — ${escaparHtml(STATUS[aluno.ultimaTentativa.status] || aluno.ultimaTentativa.status)}</div>`
        : '';

      return `
        <div class="card mb-3 border-start border-4 border-${cor}" ${aluno.motivo === 'robo_cuidando' ? 'style="opacity: .8;"' : ''}>
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <div>
                <div class="fw-semibold">${escaparHtml(aluno.nomeAluno || '—')} <span class="small text-body-secondary fw-normal">${escaparHtml(aluno.matricula)}</span></div>
                <div class="small mt-1">${turmas}</div>
              </div>
              <div class="text-end">
                <span class="badge bg-${cor}-subtle text-${cor}-emphasis border border-${cor}-subtle">${escaparHtml(aluno.rotulo)}</span>${sugestao}
                ${espera}
              </div>
            </div>
            ${aluno.detalhe ? `<div class="p-2 rounded-3 small mt-2" style="background: #dcf8c6; color: #111; max-width: 40rem;"><i class="bi bi-chat-left-text me-1"></i>"${escaparHtml(aluno.detalhe)}"</div>` : ''}
            ${etapaRobo}
            ${resumo}
            ${arquivo}
            ${conversa}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
              <div class="small">${telefone}</div>
              <div class="d-flex flex-wrap align-items-center gap-2">
                ${responsavel}
                <button type="button" class="btn btn-sm btn-outline-primary" data-abrir="${indice}"><i class="bi bi-journal-plus me-1"></i>Registrar contato</button>
              </div>
            </div>
            ${tentativa}
            ${formularioContato(indice)}
          </div>
        </div>`;
    }

    // Os botões de situação do topo também são o filtro: clicou, a lista mostra só
    // aquela situação; clicou de novo (ou em "Todos"), volta tudo.
    function desenharResumo() {
      const contagem = {};
      alunos.forEach((a) => { contagem[a.motivo] = (contagem[a.motivo] || 0) + 1; });
      if (filtroMotivo && !contagem[filtroMotivo]) filtroMotivo = null;
      const botao = (chave, rotulo, quantidade, cor) => {
        const ativo = filtroMotivo === chave;
        return `<button type="button" data-filtro="${chave || ''}" aria-pressed="${ativo}"
          class="btn btn-sm rounded-pill px-3 ${ativo ? `btn-${cor}` : `bg-${cor}-subtle text-${cor}-emphasis border border-${cor}-subtle`}">
          ${escaparHtml(rotulo)}: <strong>${quantidade}</strong></button>`;
      };
      const meus = alunos.filter((a) => a.responsavel?.usuario === eu).length;
      const ninguem = alunos.filter((a) => !a.responsavel && a.motivo !== 'robo_cuidando').length;
      const botaoResp = (chave, rotulo, quantidade) => {
        const ativo = filtroResponsavel === chave;
        return `<button type="button" data-filtro-resp="${chave}" aria-pressed="${ativo}"
          class="btn btn-sm rounded-pill px-3 ${ativo ? 'btn-secondary' : 'btn-outline-secondary'}">
          <i class="bi bi-person me-1"></i>${rotulo}: <strong>${quantidade}</strong></button>`;
      };
      document.getElementById('resumoMotivos').innerHTML = (alunos.length ? botao(null, 'Todos', alunos.length, 'dark') : '') + Object.entries(motivosLista)
        .filter(([chave]) => contagem[chave])
        .map(([chave, m]) => botao(chave, m.rotulo, contagem[chave], COR_PRIORIDADE[m.prioridade] || 'secondary'))
        .join('')
        + (alunos.length ? `<span class="vr mx-1"></span>${botaoResp('meus', 'Eu estou cuidando', meus)}${botaoResp('ninguem', 'Ninguém cuidando', ninguem)}` : '');
    }

    function passaNoFiltro(aluno) {
      if (filtroMotivo && aluno.motivo !== filtroMotivo) return false;
      if (filtroResponsavel === 'meus' && aluno.responsavel?.usuario !== eu) return false;
      // "Ninguém cuidando" = casos de pessoa sem responsável; o robô cuida dos outros.
      if (filtroResponsavel === 'ninguem' && (aluno.responsavel || aluno.motivo === 'robo_cuidando')) return false;
      return true;
    }

    function desenharLista() {
      const statusEl = document.getElementById('statusCarregamento');
      const visiveis = alunos.map((aluno, indice) => ({ aluno, indice })).filter(({ aluno }) => passaNoFiltro(aluno));
      const comRobo = alunos.filter((a) => a.motivo === 'robo_cuidando').length;
      const dePessoa = alunos.length - comRobo;
      if (alunos.length === 0) {
        statusEl.className = 'alert alert-success';
        statusEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Ninguém precisando de contato agora.';
      } else {
        statusEl.className = 'small text-body-secondary mb-2';
        const robo = comRobo ? ` O robô ainda está cuidando de mais ${comRobo} (no fim da lista, em cinza).` : '';
        statusEl.textContent = filtroMotivo || filtroResponsavel
          ? `Mostrando ${visiveis.length} de ${alunos.length} aluno(s). Quem espera há mais tempo vem primeiro.`
          : `${dePessoa} aluno(s) precisam de contato, do mais urgente para o menos urgente; dentro de cada motivo, quem espera há mais tempo vem primeiro.${robo}`;
      }
      document.getElementById('listaAlunos').innerHTML = visiveis.map(({ aluno, indice }) => cartaoAluno(aluno, indice)).join('');
    }

    document.getElementById('resumoMotivos').addEventListener('click', (evento) => {
      const botao = evento.target.closest('[data-filtro]');
      const botaoResp = evento.target.closest('[data-filtro-resp]');
      if (botao) {
        const escolhido = botao.dataset.filtro || null;
        filtroMotivo = filtroMotivo === escolhido ? null : escolhido;
        if (!escolhido) filtroResponsavel = null; // "Todos" limpa os dois filtros
      } else if (botaoResp) {
        filtroResponsavel = filtroResponsavel === botaoResp.dataset.filtroResp ? null : botaoResp.dataset.filtroResp;
      } else {
        return;
      }
      desenharResumo();
      desenharLista();
    });

    async function assumir(aluno) {
      if (aluno.responsavel && aluno.responsavel.usuario !== eu) {
        const confirmacao = await Swal.fire({
          icon: 'question',
          title: 'Assumir este aluno?',
          text: `${aluno.responsavel.nome} está cuidando deste aluno. Combine com essa pessoa antes, para os dois não ligarem.`,
          showCancelButton: true,
          confirmButtonText: 'Assumir',
          cancelButtonText: 'Cancelar'
        });
        if (!confirmacao.isConfirmed) return;
      }
      const r = await chamarApi(`/contatos/pendentes/${encodeURIComponent(aluno.matricula)}/responsavel`, { method: 'POST', body: '{}' });
      if (r.status !== 'ok') throw new Error(r.mensagem);
      notificar.ok(`Você está cuidando de ${aluno.nomeAluno || 'este aluno'}.`);
    }

    async function soltar(aluno) {
      const r = await chamarApi(`/contatos/pendentes/${encodeURIComponent(aluno.matricula)}/responsavel`, { method: 'DELETE' });
      if (r.status !== 'ok') throw new Error(r.mensagem);
      notificar.ok('Aluno solto. Outra pessoa pode assumir.');
    }

    async function carregar() {
      const statusEl = document.getElementById('statusCarregamento');
      const turma = document.getElementById('filtroTurma').value;
      statusEl.className = 'alert alert-info';
      statusEl.textContent = 'Carregando...';
      try {
        const r = await chamarApi(`/contatos/pendentes${turma ? `?turma=${encodeURIComponent(turma)}` : ''}`);
        if (r.status !== 'ok') throw new Error(r.mensagem);
        alunos = r.dados;
        motivosLista = r.motivosLista;
        desenharResumo();
        desenharLista();
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'alert alert-warning';
          statusEl.textContent = `Não foi possível carregar a lista: ${erro.message}`;
        }
      }
    }

    document.getElementById('listaAlunos').addEventListener('click', async (evento) => {
      const abrir = evento.target.closest('[data-abrir]');
      const cancelar = evento.target.closest('[data-cancelar]');
      const verConversa = evento.target.closest('[data-conversa]');
      const botaoAssumir = evento.target.closest('[data-assumir]');
      const botaoSoltar = evento.target.closest('[data-soltar]');
      if (verConversa) {
        const corpo = document.querySelector(`[data-conversa-corpo="${verConversa.dataset.conversa}"]`);
        corpo.hidden = !corpo.hidden;
      } else if (botaoAssumir || botaoSoltar) {
        const botao = botaoAssumir || botaoSoltar;
        botao.disabled = true;
        try {
          const aluno = alunos[Number(botao.dataset.assumir ?? botao.dataset.soltar)];
          await (botaoAssumir ? assumir(aluno) : soltar(aluno));
          await carregar();
        } catch (erro) {
          botao.disabled = false;
          if (erro.message !== 'Sessão expirada') notificar.erro(erro.message || 'Não foi possível concluir.');
        }
      } else if (abrir) {
        const form = document.querySelector(`[data-form-contato="${abrir.dataset.abrir}"]`);
        form.hidden = false;
        abrir.hidden = true;
        form.querySelector('[name="observacao"]').focus();
      } else if (cancelar) {
        document.querySelector(`[data-form-contato="${cancelar.dataset.cancelar}"]`).hidden = true;
        document.querySelector(`[data-abrir="${cancelar.dataset.cancelar}"]`).hidden = false;
      }
    });

    document.getElementById('listaAlunos').addEventListener('submit', async (evento) => {
      const form = evento.target.closest('[data-form-contato]');
      if (!form) return;
      evento.preventDefault();
      const aluno = alunos[Number(form.dataset.formContato)];
      const botao = form.querySelector('button[type="submit"]');
      botao.disabled = true;
      try {
        const r = await chamarApi('/contatos', {
          method: 'POST',
          body: JSON.stringify({
            matricula: aluno.matricula,
            nomeAluno: aluno.nomeAluno,
            canal: form.canal.value,
            status: form.status.value,
            motivo: form.motivo.value || null,
            observacao: form.observacao.value.trim() || null
          })
        });
        if (r.status !== 'ok') throw new Error(r.mensagem);
        const resolveu = ['respondido', 'acompanhar', 'recuperado'].includes(form.status.value);
        notificar.ok(resolveu ? `Contato registrado. ${aluno.nomeAluno || 'O aluno'} saiu da lista.` : 'Tentativa registrada. O aluno continua na lista.');
        await carregar();
      } catch (erro) {
        botao.disabled = false;
        if (erro.message !== 'Sessão expirada') notificar.erro(erro.message || 'Não foi possível registrar o contato.');
      }
    });

    document.getElementById('formFiltro').addEventListener('submit', (evento) => {
      evento.preventDefault();
      carregar();
    });

    preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi);
    carregar();
  </script>
</body>

</html>
