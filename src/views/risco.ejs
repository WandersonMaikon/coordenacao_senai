<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Alunos em risco' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <div class="page-layout">

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'risco' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Alunos em risco</h1>
            <span>2 aulas seguidas sem presença — registre o contato feito com cada aluno</span>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <form id="formFiltro" class="row g-3 align-items-end">
              <div class="col-auto">
                <label class="form-label" for="filtroTurma">Turma</label>
                <select class="form-select" id="filtroTurma">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="col-auto">
                <label class="form-label" for="filtroStatus">Status do contato</label>
                <select class="form-select" id="filtroStatus">
                  <option value="">Todos</option>
                  <option value="sem_contato">Sem contato registrado</option>
                </select>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-filter me-1"></i> Filtrar
                </button>
              </div>
              <div class="col-auto">
                <button type="button" class="btn btn-outline-light" id="btnLimparFiltro">
                  Limpar
                </button>
              </div>
            </form>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando dados...</div>

        <div class="card d-none" id="cardResultado">
          <div class="card-header d-flex align-items-center justify-content-between border-0 pb-0">
            <h6 class="card-title mb-0">Alunos <span class="text-body fw-normal" id="totalResultado"></span></h6>
          </div>
          <div class="card-body">
            <div class="accordion accordion-custom-button accordion-primary" id="accordionRisco"></div>
          </div>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="/js/turmas.js"></script>
  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    const CANAIS = { whatsapp: 'WhatsApp', ligacao: 'Ligação', presencial: 'Presencial' };
    const STATUS = {
      respondido: 'Respondido',
      sem_resposta: 'Sem resposta',
      acompanhar: 'Acompanhar',
      // A chave continua `nunca_contato` (é o valor já gravado no banco); só o
      // rótulo mudou.
      nunca_contato: 'Nunca contatado',
      recuperado: 'Recuperado'
    };

    // Cor do badge de último contato por status. A escala vai do resolvido pro
    // pendente: azul-escuro = aluno recuperado (voltou a vir), verde = respondeu,
    // azul = em acompanhamento, amarelo = tentou e não voltou, vermelho = não se
    // conseguiu contato.
    const COR_STATUS = {
      recuperado: 'primary',
      respondido: 'success',
      acompanhar: 'info',
      sem_resposta: 'warning',
      nunca_contato: 'danger'
    };
    // Usado tanto no filtro por turma quanto no formulário de contato — um mapa só
    // evita a lista de status divergir entre os dois lugares.
    const opcoesStatus = Object.entries(STATUS)
      .map(([valor, rotulo]) => `<option value="${valor}">${rotulo}</option>`)
      .join('');

    const MOTIVOS = {
      transporte: 'Transporte',
      trabalho: 'Trabalho',
      saude_atestado: 'Saúde - com atestado',
      saude_sem_atestado: 'Saúde - sem atestado',
      saude_mental: 'Saúde mental',
      financeiro: 'Financeiro',
      desmotivacao_curso: 'Desmotivação com o curso',
      problema_familiar: 'Problema familiar',
      outro: 'Outro / não informado'
    };

    // O backend já devolve quantos dias de aula seguidos o aluno faltou (diasSemVir).
    // Não dá pra derivar isso dividindo as faltas por um nº fixo de aulas: um dia com
    // duas UCs (dois professores) tem mais aulas lançadas que um dia com uma só.
    //
    // Atenção ao ler este número: ele é da SEQUÊNCIA EM ABERTO, não do semestre.
    // Um aluno que faltou 4 dias em agosto, voltou, e agora está 2 dias sem vir
    // aparece aqui como "2 dias" — os 4 de agosto já foram fechados por uma
    // presença e não contam mais. Quem quiser o acumulado do período usa a tela
    // de Faltas, que soma tudo o que foi lançado no intervalo filtrado.
    function formatarDiasFalta(diasSemVir) {
      return `${diasSemVir} ${diasSemVir === 1 ? 'dia' : 'dias'}`;
    }

    // A observação é texto livre digitado pela coordenação e entra via innerHTML —
    // sem escapar, um "<" no meio da anotação já quebra a renderização do histórico.
    function escaparHtml(texto) {
      return String(texto)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    // Formata "69993408643" como "(69) 99340-8643"
    function formatarTelefone(telefone) {
      if (telefone.length !== 11) return telefone;
      return `(${telefone.slice(0, 2)}) ${telefone.slice(2, 7)}-${telefone.slice(7)}`;
    }

    function formatarDataHora(dataIso) {
      return new Date(dataIso).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function formatarData(dataIso) {
      return new Date(dataIso).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    function badgeUltimoContato(ultimoContato, totalContatos) {
      if (!ultimoContato) {
        return '<span class="badge bg-danger bg-opacity-10 text-danger">Nunca contatado</span>';
      }
      const canal = CANAIS[ultimoContato.canal] || ultimoContato.canal || '—';
      const status = STATUS[ultimoContato.status] || ultimoContato.status || '—';
      const cor = COR_STATUS[ultimoContato.status] || 'success';
      // A partir da 2ª tentativa vale mostrar o total: várias tentativas sem
      // resposta são sinal de escalar (ligação, responsável), não de repetir a
      // mesma mensagem. Na 1ª o número não acrescenta nada.
      const tentativas = totalContatos > 1
        ? `<span class="ms-2 small text-body-secondary" title="Total de contatos registrados com este aluno">${totalContatos}ª tentativa</span>`
        : '';
      return `<span class="badge bg-${cor} bg-opacity-10 text-${cor}" title="${formatarDataHora(ultimoContato.criadoEm)}">${canal} · ${status} · ${formatarData(ultimoContato.criadoEm)}</span>${tentativas}`;
    }

    // Último dia de aula em que o aluno apareceu. Complementa a coluna de faltas:
    // "2 dias" é uma semana de sumiço na turma diária e quase um mês na
    // semipresencial — a data resolve essa ambiguidade.
    function colunaSumiuDesde(aluno) {
      // Quem nunca teve presença registrada cai no dia da primeira falta — a
      // coluna mostra uma data em todos os casos, o tooltip diz qual das duas é.
      const data = aluno.ultimaPresenca || aluno.primeiraFalta;
      if (!data) return '—';
      const titulo = aluno.ultimaPresenca
        ? 'Última presença registrada'
        : 'Nunca teve presença registrada — primeiro dia de aula com falta';
      return `<span title="${titulo}">${escaparHtml(data)}</span>`;
    }
    
    async function chamarApi(caminho, opcoes = {}) {
      const resposta = await fetch(caminho, {
        ...opcoes,
        headers: {
          Authorization: 'Bearer ' + token,
          ...(opcoes.body ? { 'Content-Type': 'application/json' } : {}),
          ...opcoes.headers
        }
      });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      return resposta.json();
    }

    function linhaDetalheHtml(indice, aluno) {
      const opcoesMotivo = Object.entries(MOTIVOS).map(([valor, rotulo]) => `<option value="${valor}">${rotulo}</option>`).join('');
      return `
        <tr class="linha-detalhe d-none" id="detalhe-${indice}">
          <td colspan="5">
            <div class="row g-4 py-2">
              <div class="col-lg-6">
                <h6 class="mb-2">Histórico de contatos</h6>
                <div id="historico-${indice}" class="text-body">Carregando...</div>
              </div>
              <div class="col-lg-6">
                <h6 class="mb-2" id="tituloForm-${indice}">Registrar novo contato</h6>
                <form class="formContato row g-2" data-matricula="${aluno.matricula}" data-nome="${aluno.nomeAluno || ''}" data-indice="${indice}">
                  <div class="col-sm-6">
                    <label class="form-label">Canal</label>
                    <select class="form-select" name="canal" required>
                      <option value="whatsapp">WhatsApp</option>
                      <option value="ligacao">Ligação</option>
                      <option value="presencial">Presencial</option>
                    </select>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status" required>
                      ${opcoesStatus}
                    </select>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label">Motivo da falta</label>
                    <select class="form-select" name="motivo">
                      <option value="">—</option>
                      ${opcoesMotivo}
                    </select>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Observação</label>
                    <textarea class="form-control" name="observacao" rows="2"></textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-sm">Salvar contato</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm btnCancelarEdicao d-none">Cancelar</button>
                    <span class="statusFormContato ms-2"></span>
                  </div>
                </form>
              </div>
            </div>
          </td>
        </tr>
      `;
    }

    function linhaHistoricoHtml(contato, indice) {
      const canal = CANAIS[contato.canal] || contato.canal || '—';
      const status = STATUS[contato.status] || contato.status || '—';
      const motivo = MOTIVOS[contato.motivo] || contato.motivo;
      // Editado = atualizadoEm mais de 1s depois de criadoEm. A margem evita
      // marcar como corrigido o registro recém-criado, em que os dois timestamps
      // são gravados na mesma operação com alguns milissegundos de diferença.
      const editado = contato.atualizadoEm &&
        new Date(contato.atualizadoEm).getTime() - new Date(contato.criadoEm).getTime() > 1000;
      return `
        <div class="border-bottom pb-2 mb-2">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div><strong>${canal}</strong> · ${status}${motivo ? ` · ${escaparHtml(motivo)}` : ''}</div>
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none btnEditarContato"
                    data-indice="${indice}" data-id="${contato.id}" title="Editar este contato">
              <i class="bi bi-pencil"></i>
            </button>
          </div>
          ${contato.observacao ? `<div class="text-body">${escaparHtml(contato.observacao)}</div>` : ''}
          <div class="text-body text-2xs">
            ${formatarDataHora(contato.criadoEm)} — ${escaparHtml(contato.contatadoPor || '—')}
            ${editado ? ` · editado em ${formatarDataHora(contato.atualizadoEm)}` : ''}
          </div>
        </div>
      `;
    }

    // Guarda os contatos já carregados por linha da tabela, pra o botão "editar"
    // preencher o formulário sem precisar bater na API de novo (e sem despejar os
    // campos em atributos data- do HTML).
    const historicoPorIndice = {};

    async function carregarHistorico(indice, matricula) {
      const container = document.getElementById(`historico-${indice}`);
      try {
        const resposta = await chamarApi(`/contatos?matricula=${encodeURIComponent(matricula)}`);
        const contatos = resposta.dados || [];
        historicoPorIndice[indice] = contatos;

        if (contatos.length === 0) {
          container.innerHTML = '<p class="text-body mb-0">Nenhum contato registrado ainda.</p>';
        } else {
          container.innerHTML = contatos.map((contato) => linhaHistoricoHtml(contato, indice)).join('');
        }

        // A lista vem do mais recente pro mais antigo, então o primeiro é o que
        // o badge da linha mostra — importante depois de editar um contato.
        const badge = document.getElementById(`badge-contato-${indice}`);
        if (badge) badge.innerHTML = badgeUltimoContato(contatos[0] || null, contatos.length);
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          container.innerHTML = '<p class="text-warning mb-0">Não foi possível carregar o histórico agora.</p>';
        }
      }
    }

    // O formulário é um só: em modo edição ele é preenchido com o contato
    // escolhido e o submit vira PUT. form.dataset.editandoId é o que distingue.
    function entrarModoEdicao(indice, idContato) {
      const contato = (historicoPorIndice[indice] || []).find((item) => item.id === idContato);
      if (!contato) return;

      const form = document.querySelector(`.formContato[data-indice="${indice}"]`);
      if (!form) return;

      form.dataset.editandoId = String(idContato);
      form.canal.value = contato.canal || 'whatsapp';
      form.status.value = contato.status || 'respondido';
      form.motivo.value = contato.motivo || '';
      form.observacao.value = contato.observacao || '';

      document.getElementById(`tituloForm-${indice}`).textContent =
        `Editando contato de ${formatarDataHora(contato.criadoEm)}`;
      form.querySelector('button[type="submit"]').textContent = 'Salvar alterações';
      form.querySelector('.btnCancelarEdicao').classList.remove('d-none');
      form.querySelector('.statusFormContato').textContent = '';
      form.canal.focus();
    }

    function alternarDetalhe(indice, matricula) {
      const linha = document.getElementById(`detalhe-${indice}`);
      const abrindo = linha.classList.contains('d-none');

      linha.classList.toggle('d-none');

      if (abrindo) carregarHistorico(indice, matricula);
    }

    function sairModoEdicao(form) {
      const indice = form.dataset.indice;
      delete form.dataset.editandoId;
      form.reset();
      document.getElementById(`tituloForm-${indice}`).textContent = 'Registrar novo contato';
      form.querySelector('button[type="submit"]').textContent = 'Salvar contato';
      form.querySelector('.btnCancelarEdicao').classList.add('d-none');
    }

    function linhaAlunoHtml(aluno, indice) {
      return `
        <tr class="linha-aluno" style="cursor: pointer" data-indice="${indice}" data-matricula="${aluno.matricula}">
          <td>
            ${aluno.nomeAluno || '—'}
            ${aluno.telefone ? `<a href="https://wa.me/55${aluno.telefone}" target="_blank" rel="noopener" class="text-success ms-2" title="Chamar no WhatsApp — ${formatarTelefone(aluno.telefone)}"><i class="bi bi-whatsapp"></i></a>` : ''}
          </td>
          <td>${aluno.matricula}</td>
          <td class="text-end"><span class="badge bg-danger bg-opacity-10 text-danger" title="${aluno.totalFaltas} aula(s) perdida(s) nesta sequência — não é o total de faltas do semestre">${formatarDiasFalta(aluno.diasSemVir)}</span></td>
          <td id="badge-contato-${indice}">${badgeUltimoContato(aluno.ultimoContato, aluno.totalContatos)}</td>
          <td class="text-end">${colunaSumiuDesde(aluno)}</td>
        </tr>
        ${linhaDetalheHtml(indice, aluno)}
      `;
    }

    // status: '' = todos, 'sem_contato' = nunca contatado, ou um valor de STATUS.
    // O filtro é aplicado aqui no client porque /alunos-risco já devolve o último
    // contato de cada aluno — não vale um parâmetro novo na API só pra isso.
    async function carregarRisco(turma, status) {
      const statusEl = document.getElementById('statusCarregamento');
      const cardResultado = document.getElementById('cardResultado');
      statusEl.className = 'alert alert-info';
      statusEl.textContent = 'Carregando dados...';
      statusEl.classList.remove('d-none');
      cardResultado.classList.add('d-none');

      try {
        const params = new URLSearchParams();
        if (turma) params.set('turma', turma);
        const query = params.toString();
        const resposta = await chamarApi(query ? `/alunos-risco?${query}` : '/alunos-risco');

        const alunos = status
          ? resposta.dados.filter((aluno) => (aluno.ultimoContato ? aluno.ultimoContato.status : 'sem_contato') === status)
          : resposta.dados;

        if (alunos.length === 0) {
          document.getElementById('totalResultado').textContent = '(0)';
          statusEl.className = 'alert alert-success';
          statusEl.textContent = status
            ? 'Nenhum aluno em risco com esse status de contato.'
            : 'Nenhum aluno em risco no momento.';
          statusEl.classList.remove('d-none');
          cardResultado.classList.add('d-none');
          return;
        }

        const turmas = new Map();
        alunos.forEach((aluno, indice) => {
          const chaveTurma = aluno.codigoTurma || aluno.nomeTurma || '—';
          if (!turmas.has(chaveTurma)) turmas.set(chaveTurma, { nome: nomeTurmaLimpo(aluno.nomeTurma) || chaveTurma, ultimaAula: aluno.ultimaAulaTurma || null, alunos: [] });
          turmas.get(chaveTurma).alunos.push({ ...aluno, indice });
        });

        turmas.forEach((turma) => turma.alunos.sort((a, b) => (a.nomeAluno || '').localeCompare(b.nomeAluno || '', 'pt-BR')));

        const accordion = document.getElementById('accordionRisco');
        accordion.innerHTML = Array.from(turmas.entries()).map(([codigo, turma], indiceTurma) => {
          const idColapso = `colapsoRiscoTurma${indiceTurma}`;
          const linhas = turma.alunos.map((aluno) => linhaAlunoHtml(aluno, aluno.indice)).join('');

          return `
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${idColapso}">
                  ${turma.nome} (${codigo}) <span class="badge border ms-2" style="color: inherit; border-color: currentColor !important;">${turma.alunos.length}</span>${turma.ultimaAula ? `<span class="ms-2 small text-body-secondary">última atualização: ${escaparHtml(turma.ultimaAula)}</span>` : ''}
                </button>
              </h2>
              <div id="${idColapso}" class="accordion-collapse collapse" data-bs-parent="#accordionRisco">
                <div class="accordion-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Aluno</th>
                          <th>Matrícula</th>
                          <th class="text-end">Faltas</th>
                          <th>Último contato</th>
                          <th class="text-end">Sumiu desde</th>
                        </tr>
                      </thead>
                      <tbody>${linhas}</tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        document.getElementById('totalResultado').textContent = `(${alunos.length})`;

        statusEl.classList.add('d-none');
        cardResultado.classList.remove('d-none');

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'alert alert-warning';
          statusEl.textContent = 'Não foi possível carregar os alunos em risco agora.';
        }
      }
    }

    // O projeto não carrega o bootstrap.bundle.js (só o CSS), então o toggle
    // do accordion precisa ser feito manualmente aqui.
    document.getElementById('accordionRisco').addEventListener('click', (evento) => {
      const botaoEditar = evento.target.closest('.btnEditarContato');
      if (botaoEditar) {
        entrarModoEdicao(botaoEditar.dataset.indice, Number(botaoEditar.dataset.id));
        return;
      }

      const botaoCancelar = evento.target.closest('.btnCancelarEdicao');
      if (botaoCancelar) {
        sairModoEdicao(botaoCancelar.closest('.formContato'));
        return;
      }

      // Clicar em qualquer ponto da linha do aluno abre o painel de contato — a
      // coluna de ação com o botão "Contato" saiu por ser um segundo caminho pro
      // mesmo lugar, e deu espaço pro "sumiu desde".
      const linhaAluno = evento.target.closest('tr.linha-aluno');
      if (linhaAluno) {
        // O ícone do WhatsApp (e qualquer campo do formulário, se um dia a linha
        // ganhar um) mantém o comportamento próprio em vez de abrir o painel.
        if (evento.target.closest('a, button, input, select, textarea, label')) return;
        alternarDetalhe(linhaAluno.dataset.indice, linhaAluno.dataset.matricula);
        return;
      }

      const botaoAccordion = evento.target.closest('.accordion-button');
      if (!botaoAccordion) return;

      const alvo = document.querySelector(botaoAccordion.getAttribute('data-bs-target'));
      const jaAberto = botaoAccordion.classList.contains('collapsed') === false;

      document.querySelectorAll('#accordionRisco .accordion-button').forEach((b) => b.classList.add('collapsed'));
      document.querySelectorAll('#accordionRisco .accordion-collapse').forEach((c) => c.classList.remove('show'));

      if (!jaAberto) {
        botaoAccordion.classList.remove('collapsed');
        alvo.classList.add('show');
      }
    });

    document.getElementById('accordionRisco').addEventListener('submit', async (evento) => {
      const form = evento.target.closest('.formContato');
      if (!form) return;
      evento.preventDefault();

      const indice = form.dataset.indice;
      const statusForm = form.querySelector('.statusFormContato');
      const botaoSalvar = form.querySelector('button[type="submit"]');
      const idEditando = form.dataset.editandoId;

      const corpo = {
        matricula: form.dataset.matricula,
        nomeAluno: form.dataset.nome,
        canal: form.canal.value,
        status: form.status.value,
        motivo: form.motivo.value,
        observacao: form.observacao.value
      };

      botaoSalvar.disabled = true;
      statusForm.className = 'statusFormContato ms-2 text-body';
      statusForm.textContent = 'Salvando...';

      try {
        const resposta = idEditando
          ? await chamarApi(`/contatos/${idEditando}`, { method: 'PUT', body: JSON.stringify(corpo) })
          : await chamarApi('/contatos', { method: 'POST', body: JSON.stringify(corpo) });

        if (resposta.status !== 'ok') {
          throw new Error(resposta.mensagem || 'Erro ao salvar');
        }

        statusForm.className = 'statusFormContato ms-2 text-success';
        const mensagemOk = idEditando ? 'Contato atualizado.' : 'Contato registrado.';

        // Sai da edição antes de recarregar: sairModoEdicao dá reset() no form,
        // o que apagaria a mensagem se viesse depois.
        if (idEditando) sairModoEdicao(form);
        else form.reset();

        statusForm.textContent = mensagemOk;

        // carregarHistorico já atualiza o badge da linha com o contato mais
        // recente — inclusive quando o editado não foi o último.
        await carregarHistorico(indice, corpo.matricula);

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusForm.className = 'statusFormContato ms-2 text-warning';
          statusForm.textContent = 'Não foi possível salvar agora.';
        }
      } finally {
        botaoSalvar.disabled = false;
      }
    });

    document.getElementById('formFiltro').addEventListener('submit', (evento) => {
      evento.preventDefault();
      carregarRisco(
        document.getElementById('filtroTurma').value,
        document.getElementById('filtroStatus').value
      );
    });

    document.getElementById('btnLimparFiltro').addEventListener('click', () => {
      document.getElementById('filtroTurma').value = '';
      document.getElementById('filtroStatus').value = '';
      carregarRisco('', '');
    });

    // O filtro de status sai do mesmo mapa que rotula os badges — uma lista só,
    // pra não divergir quando um status novo for criado.
    document.getElementById('filtroStatus').insertAdjacentHTML('beforeend', opcoesStatus);

    preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi);
    carregarRisco();
  </script>
</body>

</html>
