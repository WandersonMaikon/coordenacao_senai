<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Faltas' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <div class="page-layout">
    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'faltas' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Frequência</h1>
            <span>Frequência consolidada por turma no período — quem está perto de reprovar por falta</span>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <form id="formFiltro" class="row g-3 align-items-end">
              <div class="col-auto">
                <label class="form-label" for="filtroDataInicio">Data da aula — início</label>
                <input type="date" class="form-control" id="filtroDataInicio">
              </div>
              <div class="col-auto">
                <label class="form-label" for="filtroDataFim">Data da aula — fim</label>
                <input type="date" class="form-control" id="filtroDataFim">
              </div>
              <div class="col-auto">
                <label class="form-label" for="filtroTurma">Turma</label>
                <select class="form-select" id="filtroTurma">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-filter me-1"></i> Filtrar
                </button>
              </div>
              <div class="col-auto">
                <button type="button" class="btn btn-outline-light" id="btnLimparFiltro">
                  Limpar
                </button>
              </div>
            </form>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando dados...</div>

        <div id="avisoCobertura" class="alert alert-warning d-none"></div>

        <div class="card d-none" id="cardResultado">
          <div class="card-header d-flex align-items-center justify-content-between border-0 pb-0">
            <h6 class="card-title mb-0">Turmas <span class="text-body fw-normal" id="totalResultado"></span></h6>
          </div>
          <div class="card-body">
            <div class="accordion accordion-custom-button accordion-primary" id="accordionFaltas"></div>
          </div>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="/js/turmas.js"></script>
  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    // Nome de aluno e de turma vêm do SGE e entram via innerHTML — um "<" no meio
    // de um nome já quebraria a renderização da tabela.
    function escaparHtml(texto) {
      return String(texto ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function nomeCurto(nomeCompleto) {
      if (!nomeCompleto) return '—';
      return nomeCompleto.trim().split(/\s+/).slice(0, 2).join(' ');
    }

    // Formata "69993408643" como "(69) 99340-8643"
    function formatarTelefone(telefone) {
      if (telefone.length !== 11) return telefone;
      return `(${telefone.slice(0, 2)}) ${telefone.slice(2, 7)}-${telefone.slice(7)}`;
    }

    async function chamarApi(caminho) {
      const resposta = await fetch(caminho, { headers: { Authorization: 'Bearer ' + token } });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      return resposta.json();
    }

    // Barra de frequência: a cor vem da faixa, não do valor bruto — verde acima do
    // mínimo, âmbar na zona de atenção (até 10 pontos acima do mínimo, onde ainda dá
    // pra reverter) e vermelho abaixo do mínimo, onde já reprovou por falta.
    function corFrequencia(frequencia, minimo) {
      if (frequencia === null) return 'secondary';
      if (frequencia < minimo) return 'danger';
      if (frequencia < minimo + 10) return 'warning';
      return 'success';
    }

    function barraFrequencia(frequencia, minimo) {
      if (frequencia === null) return '<span class="text-body-secondary">—</span>';
      const cor = corFrequencia(frequencia, minimo);
      return `
        <div class="d-flex align-items-center gap-2">
          <div class="progress flex-grow-1" style="height: 6px; min-width: 80px;" role="img"
               aria-label="Frequência de ${frequencia}%">
            <div class="progress-bar bg-${cor}" style="width: ${frequencia}%"></div>
          </div>
          <span class="text-${cor} fw-semibold" style="min-width: 52px; text-align: right;">${frequencia}%</span>
        </div>
      `;
    }

    function linhaAlunoHtml(aluno, minimo) {
      // Quantas aulas ainda pode perder antes de cair abaixo do mínimo. É o número
      // que transforma o relatório em conversa: "você pode faltar mais 2 aulas".
      const margem = Math.floor(aluno.aulas - aluno.faltas - (minimo / 100) * aluno.aulas);
      return `
        <tr>
          <td>
            ${escaparHtml(aluno.nomeAluno)}
            ${aluno.telefone ? `<a href="https://wa.me/55${aluno.telefone}" target="_blank" rel="noopener" class="text-success ms-2" title="Chamar no WhatsApp — ${formatarTelefone(aluno.telefone)}"><i class="bi bi-whatsapp"></i></a>` : ''}
          </td>
          <td>${escaparHtml(aluno.matricula)}</td>
          <td class="text-end" title="${aluno.faltas} de ${aluno.aulas} aula(s)">${aluno.faltas}/${aluno.aulas}</td>
          <td style="min-width: 160px;">${barraFrequencia(aluno.frequencia, minimo)}</td>
          <td class="text-end">${
            aluno.frequencia === null ? '—'
              : margem < 0 ? '<span class="text-danger">já reprovou</span>'
              : `${margem} aula(s)`
          }</td>
        </tr>
      `;
    }

    async function carregarFaltas(dataInicio, dataFim, turma) {
      const statusEl = document.getElementById('statusCarregamento');
      const cardResultado = document.getElementById('cardResultado');
      const avisoCobertura = document.getElementById('avisoCobertura');
      statusEl.className = 'alert alert-info';
      statusEl.textContent = 'Carregando dados...';
      statusEl.classList.remove('d-none');
      cardResultado.classList.add('d-none');
      avisoCobertura.classList.add('d-none');

      try {
        const params = new URLSearchParams();
        if (dataInicio) params.set('dataInicio', dataInicio);
        if (dataFim) params.set('dataFim', dataFim);
        if (turma) params.set('turma', turma);
        const query = params.toString();
        const resposta = await chamarApi(`/frequencia${query ? `?${query}` : ''}`);
        const minimo = resposta.frequenciaMinima;

        // Lançamentos anteriores à v4.1 do userscript não trazem o total de aulas
        // do dia, então não entram no cálculo. Sem esse aviso, o relatório pareceria
        // completo mostrando só a parte do período que o script novo já cobriu.
        if (resposta.diasSemTotalDeAulas > 0) {
          avisoCobertura.classList.remove('d-none');
          avisoCobertura.innerHTML = `
            <strong>${resposta.diasSemTotalDeAulas} lançamento(s) fora do cálculo.</strong>
            São chamadas salvas antes da atualização do userscript, que não informavam quantas
            aulas o dia teve — sem esse número não dá pra calcular percentual. Elas entram no
            relatório assim que o professor salvar a frequência daquela turma de novo.
          `;
        }

        const accordion = document.getElementById('accordionFaltas');

        if (resposta.dados.length === 0) {
          accordion.innerHTML = `<p class="text-center text-body py-4 mb-0">Nenhuma aula lançada${dataInicio ? ' nesse período.' : '.'}</p>`;
        } else {
          accordion.innerHTML = resposta.dados.map((dadosTurma, indice) => {
            const idColapso = `colapsoTurma${indice}`;
            const cor = corFrequencia(dadosTurma.frequenciaTurma, minimo);
            const professores = dadosTurma.professores.map(nomeCurto).join(' / ') || '—';

            return `
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${idColapso}">
                    <span class="flex-grow-1">
                      ${escaparHtml(nomeTurmaLimpo(dadosTurma.nomeTurma))} (${escaparHtml(dadosTurma.codigoTurma)})
                      <span class="ms-2 small text-body-secondary">Professor: ${escaparHtml(professores)}</span>
                    </span>
                    <span class="badge bg-${cor} bg-opacity-10 text-${cor} ms-2">${dadosTurma.frequenciaTurma}% de frequência</span>
                    ${dadosTurma.abaixoDoMinimo > 0
                      ? `<span class="badge bg-danger bg-opacity-10 text-danger ms-2">${dadosTurma.abaixoDoMinimo} abaixo de ${minimo}%</span>`
                      : ''}
                  </button>
                </h2>
                <div id="${idColapso}" class="accordion-collapse collapse" data-bs-parent="#accordionFaltas">
                  <div class="accordion-body p-0">
                    <div class="px-3 py-2 small text-body-secondary border-bottom">
                      ${dadosTurma.totalAulas} aula(s) lançada(s) no período · ${dadosTurma.totalAlunos} aluno(s)
                    </div>
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0">
                        <thead>
                          <tr>
                            <th>Aluno</th>
                            <th>Matrícula</th>
                            <th class="text-end" title="Aulas perdidas sobre aulas lançadas">Faltas</th>
                            <th>Frequência</th>
                            <th class="text-end" title="Quantas aulas ainda pode perder sem ficar abaixo do mínimo">Margem</th>
                          </tr>
                        </thead>
                        <tbody>${dadosTurma.alunos.map((aluno) => linhaAlunoHtml(aluno, minimo)).join('')}</tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

        document.getElementById('totalResultado').textContent = `(${resposta.total})`;

        statusEl.classList.add('d-none');
        cardResultado.classList.remove('d-none');

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'alert alert-warning';
          statusEl.textContent = 'Não foi possível carregar a frequência agora.';
        }
      }
    }

    // O projeto não carrega o bootstrap.bundle.js (só o CSS), então o toggle
    // do accordion precisa ser feito manualmente aqui.
    document.getElementById('accordionFaltas').addEventListener('click', (evento) => {
      const botao = evento.target.closest('.accordion-button');
      if (!botao) return;

      const alvo = document.querySelector(botao.getAttribute('data-bs-target'));
      const jaAberto = botao.classList.contains('collapsed') === false;

      document.querySelectorAll('#accordionFaltas .accordion-button').forEach((b) => b.classList.add('collapsed'));
      document.querySelectorAll('#accordionFaltas .accordion-collapse').forEach((c) => c.classList.remove('show'));

      if (!jaAberto) {
        botao.classList.remove('collapsed');
        alvo.classList.add('show');
      }
    });

    // Padrão: do dia 1 do mês atual até hoje.
    function dataIsoLocal(date) {
      const ano = date.getFullYear();
      const mes = String(date.getMonth() + 1).padStart(2, '0');
      const dia = String(date.getDate()).padStart(2, '0');
      return `${ano}-${mes}-${dia}`;
    }
    function definirPeriodoPadrao() {
      const hoje = new Date();
      const inicioMes = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
      document.getElementById('filtroDataInicio').value = dataIsoLocal(inicioMes);
      document.getElementById('filtroDataFim').value = dataIsoLocal(hoje);
    }

    document.getElementById('formFiltro').addEventListener('submit', (evento) => {
      evento.preventDefault();
      carregarFaltas(
        document.getElementById('filtroDataInicio').value,
        document.getElementById('filtroDataFim').value,
        document.getElementById('filtroTurma').value
      );
    });
    document.getElementById('btnLimparFiltro').addEventListener('click', () => {
      definirPeriodoPadrao();
      document.getElementById('filtroTurma').value = '';
      carregarFaltas(document.getElementById('filtroDataInicio').value, document.getElementById('filtroDataFim').value, '');
    });

    preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi);
    definirPeriodoPadrao();
    carregarFaltas(document.getElementById('filtroDataInicio').value, document.getElementById('filtroDataFim').value, '');
  </script>
</body>

</html>