<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'Faltas' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <div class="page-layout">
    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'faltas' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">Faltas</h1>
            <span>Todos os lançamentos capturados pelo userscript</span>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <form id="formFiltro" class="row g-3 align-items-end">
              <div class="col-auto">
                <label class="form-label" for="filtroDataInicio">Data da aula — início</label>
                <input type="date" class="form-control" id="filtroDataInicio">
              </div>
              <div class="col-auto">
                <label class="form-label" for="filtroDataFim">Data da aula — fim</label>
                <input type="date" class="form-control" id="filtroDataFim">
              </div>
              <div class="col-auto">
                <label class="form-label" for="filtroTurma">Turma</label>
                <select class="form-select" id="filtroTurma">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="col-auto">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="filtroIncluirEncerradas">
                  <label class="form-check-label" for="filtroIncluirEncerradas">Incluir turmas encerradas</label>
                </div>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-filter me-1"></i> Filtrar
                </button>
              </div>
              <div class="col-auto">
                <button type="button" class="btn btn-outline-light" id="btnLimparFiltro">
                  Limpar
                </button>
              </div>
            </form>
          </div>
        </div>

        <div id="statusCarregamento" class="alert alert-info">Carregando dados...</div>

        <div class="card d-none" id="cardResultado">
          <div class="card-header d-flex align-items-center justify-content-between border-0 pb-0">
            <h6 class="card-title mb-0">Turmas com falta no período <span class="text-body fw-normal" id="totalResultado"></span></h6>
          </div>
          <div class="card-body">
            <div class="accordion accordion-custom-button accordion-primary" id="accordionFaltas"></div>
          </div>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="/js/turmas.js"></script>
  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    // Contamos os dias de aula distintos em que o aluno teve falta. Não dá pra
    // dividir o total de aulas por um nº fixo: quando dois professores dão aula
    // pra turma no mesmo dia, esse dia tem duas UCs lançadas e mais aulas que um
    // dia com uma UC só — dividir inflaria a conta. O total de aulas perdidas
    // continua visível no tooltip do badge.
    function formatarDiasFalta(diasComFalta) {
      return `${diasComFalta} ${diasComFalta === 1 ? 'dia' : 'dias'}`;
    }

    // Nome de aluno, turma e UC vêm do SGE e entram via innerHTML — um "<" no meio
    // de qualquer um deles já quebraria a renderização da tabela.
    function escaparHtml(texto) {
      return String(texto ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    const DIAS_SEMANA = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];

    // dataAula chega como "dd/mm/aaaa" (formato do SGE), não como data ISO —
    // por isso o parse é manual em vez de new Date(string).
    function dataAulaParaDate(dataAula) {
      const [dia, mes, ano] = String(dataAula || '').split('/').map(Number);
      if (!dia || !mes || !ano) return null;
      return new Date(ano, mes - 1, dia);
    }

    function diaDaSemana(dataAula) {
      const data = dataAulaParaDate(dataAula);
      return data ? DIAS_SEMANA[data.getDay()] : '';
    }

    function dataComDiaSemana(dataAula) {
      const dia = diaDaSemana(dataAula);
      return dia ? `${dataAula} (${dia})` : dataAula || '—';
    }

    // Detalhe do aluno: cada dia em que faltou (mais recente primeiro) e, dentro
    // do dia, em qual UC. Um dia com dois professores aparece com as duas UCs —
    // falta concentrada numa UC só aponta pra matéria/horário, não pro aluno.
    function detalheFaltasHtml(faltas) {
      const porDia = new Map();
      for (const falta of faltas) {
        if (!porDia.has(falta.dataAula)) porDia.set(falta.dataAula, []);
        porDia.get(falta.dataAula).push(falta);
      }
      const dias = [...porDia.entries()]
        .sort((a, b) => (dataAulaParaDate(b[0]) || 0) - (dataAulaParaDate(a[0]) || 0));

      return `
        <ul class="list-unstyled mb-0 small">
          ${dias.map(([dataAula, faltasDoDia]) => `
            <li class="d-flex flex-wrap align-items-center gap-2 py-1">
              <span class="fw-semibold" style="min-width: 9rem;">${escaparHtml(dataComDiaSemana(dataAula))}</span>
              ${faltasDoDia.map((falta) => `<span class="badge border text-body fw-normal">${escaparHtml(falta.uc || '(sem UC)')} · ${falta.qtd} aula(s)</span>`).join('')}
            </li>
          `).join('')}
        </ul>
      `;
    }

    function nomeCurto(nomeCompleto) {
      if (!nomeCompleto) return '—';
      return nomeCompleto.trim().split(/\s+/).slice(0, 2).join(' ');
    }

    // O nome do professor é digitado por ele mesmo no Tampermonkey (uma vez por
    // máquina), então o mesmo professor chega escrito de formas diferentes —
    // "Wanderson Maikon da Silva" numa máquina, "Wanderson Maikon" na outra. O
    // Set de professores só tira os nomes idênticos; depois do nomeCurto (dois
    // primeiros nomes) essas variações viram a mesma string e apareciam
    // repetidas no cabeçalho da turma. A dedup tem que ser feita aqui, sobre o
    // nome já encurtado e sem depender de acento nem de caixa.
    // Efeito colateral aceito: dois professores diferentes que compartilhem os
    // dois primeiros nomes aparecem como um só — mas eles já apareciam escritos
    // igual antes desta correção, então não se perde informação na tela.
    function nomesCurtosUnicos(nomes) {
      const vistos = new Map();
      for (const nome of nomes) {
        const curto = nomeCurto(nome);
        const chave = curto.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        if (!vistos.has(chave)) vistos.set(chave, curto);
      }
      return [...vistos.values()];
    }

    // Formata "69993408643" como "(69) 99340-8643"
    function formatarTelefone(telefone) {
      if (telefone.length !== 11) return telefone;
      return `(${telefone.slice(0, 2)}) ${telefone.slice(2, 7)}-${telefone.slice(7)}`;
    }

    async function chamarApi(caminho) {
      const resposta = await fetch(caminho, { headers: { Authorization: 'Bearer ' + token } });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      return resposta.json();
    }

    const incluirEncerradas = () => document.getElementById('filtroIncluirEncerradas').checked;

    async function carregarFaltas(dataInicio, dataFim, turma) {
      const statusEl = document.getElementById('statusCarregamento');
      const cardResultado = document.getElementById('cardResultado');
      statusEl.className = 'alert alert-info';
      statusEl.textContent = 'Carregando dados...';
      statusEl.classList.remove('d-none');
      cardResultado.classList.add('d-none');

      try {
        const params = new URLSearchParams();
        if (dataInicio) params.set('dataInicio', dataInicio);
        if (dataFim) params.set('dataFim', dataFim);
        if (turma) params.set('turma', turma);
        if (incluirEncerradas()) params.set('incluirEncerradas', '1');
        const query = params.toString();
        const caminho = query ? `/lancamentos?${query}` : '/lancamentos';
        const resposta = await chamarApi(caminho);

        const accordion = document.getElementById('accordionFaltas');
        // Declarado fora do if: o resumo no título do card lê este mapa depois do
        // bloco, e `const` dentro do else não existiria lá fora.
        const turmas = new Map();

        if (resposta.dados.length === 0) {
          accordion.innerHTML = `<p class="text-center text-body py-4 mb-0">Nenhum lançamento encontrado${dataInicio ? ' para esse período.' : '.'}</p>`;
        } else {
          resposta.dados.forEach((item) => {
            const chaveTurma = item.codigoTurma || item.nomeTurma || '—';
            if (!turmas.has(chaveTurma)) turmas.set(chaveTurma, { nome: item.nomeTurma || chaveTurma, professores: new Set(), alunos: new Map() });
            // A mesma turma pode ter mais de um professor lançando (uma UC cada).
            if (item.professor) turmas.get(chaveTurma).professores.add(item.professor);

            // Soma as faltas de todos os lançamentos do aluno nessa turma. Agora
            // um mesmo dia pode ter mais de um lançamento (um por UC), então as
            // faltas do dia somam e os dias distintos são contados à parte.
            const alunos = turmas.get(chaveTurma).alunos;
            const chaveAluno = item.matricula || item.nomeAluno || '—';
            if (!alunos.has(chaveAluno)) {
              alunos.set(chaveAluno, { nome: item.nomeAluno || '—', telefone: item.aluno?.telefone || '', totalFaltas: 0, diasComFalta: new Set(), faltas: [], ultimaFalta: null });
            }
            const aluno = alunos.get(chaveAluno);
            const faltasDoLancamento = item.qtdFaltas || 0;
            aluno.totalFaltas += faltasDoLancamento;

            if (faltasDoLancamento > 0) {
              aluno.diasComFalta.add(item.dataAula || '');

              // Cada falta com dia e UC, pro detalhe que abre ao clicar no aluno.
              // Lançamento de presença não entra: só interessa onde houve falta.
              aluno.faltas.push({ dataAula: item.dataAula || '', uc: item.uc || '', qtd: faltasDoLancamento });

              // Data da falta mais recente do período, pra separar quem faltou no
              // começo do mês e já voltou de quem faltou ontem.
              const data = dataAulaParaDate(item.dataAula);
              const atual = dataAulaParaDate(aluno.ultimaFalta);
              if (data && (!atual || data > atual)) aluno.ultimaFalta = item.dataAula;
            }
          });

          accordion.innerHTML = Array.from(turmas.entries()).map(([codigo, turma], indice) => {
            const idColapso = `colapsoTurma${indice}`;
            // Ordem alfabética não diz nada: quem precisa de atenção é quem mais
            // faltou, então a lista desce do pior pro melhor. Empate no nº de dias
            // desempata pelas aulas perdidas (quem faltou o dia todo vem antes de
            // quem perdeu uma aula só) e, por fim, pelo nome.
            const listaAlunos = Array.from(turma.alunos.values())
              .filter((aluno) => aluno.totalFaltas > 0)
              .sort((a, b) =>
                b.diasComFalta.size - a.diasComFalta.size
                || b.totalFaltas - a.totalFaltas
                || a.nome.localeCompare(b.nome, 'pt-BR'));
            if (listaAlunos.length === 0) return '';
            const linhas = listaAlunos.map((aluno, indiceAluno) => `
              <tr class="linha-aluno" data-detalhe="detalheFalta${indice}-${indiceAluno}" style="cursor: pointer;" title="Clique para ver os dias e UCs das faltas">
                <td>
                  <i class="bi bi-chevron-right me-1 small icone-detalhe"></i>
                  ${escaparHtml(aluno.nome)}
                  ${aluno.telefone ? `<a href="https://wa.me/55${aluno.telefone}" target="_blank" rel="noopener" class="text-success ms-2" title="Chamar no WhatsApp — ${formatarTelefone(aluno.telefone)}"><i class="bi bi-whatsapp"></i></a>` : ''}
                </td>
                <td class="text-end">
                  <span class="badge bg-warning bg-opacity-10 text-warning" title="Dias de aula em que faltou, no período filtrado">${formatarDiasFalta(aluno.diasComFalta.size)}</span>
                </td>
                <td class="text-end small">${dataComDiaSemana(aluno.ultimaFalta)}</td>
              </tr>
              <tr id="detalheFalta${indice}-${indiceAluno}" class="d-none">
                <td colspan="3" class="bg-body-tertiary ps-5">${detalheFaltasHtml(aluno.faltas)}</td>
              </tr>
            `).join('');

            return `
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${idColapso}">
                    <span class="flex-grow-1">
                      ${nomeTurmaLimpo(turma.nome)} (${codigo})
                      <span class="ms-2 small">Professor: ${escaparHtml(nomesCurtosUnicos(turma.professores).join(' / ')) || '—'}</span>
                    </span>
                    <span class="badge border ms-2" style="color: inherit; border-color: currentColor !important;" title="Alunos com pelo menos uma falta no período">${listaAlunos.length} aluno(s)</span>
                  </button>
                </h2>
                <div id="${idColapso}" class="accordion-collapse collapse" data-bs-parent="#accordionFaltas">
                  <div class="accordion-body p-0">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0">
                        <thead>
                          <tr>
                            <th>Aluno</th>
                            <th class="text-end">Dias com falta</th>
                            <th class="text-end" title="Falta mais recente do aluno no período filtrado">Última falta</th>
                          </tr>
                        </thead>
                        <tbody>${linhas}</tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

        // O total de lançamentos (uma linha por aluno/dia/UC, presenças inclusive)
        // não significa nada pra quem lê: 813 "lançamentos" é o tamanho da tabela,
        // não o tamanho do problema. O que importa é quantas turmas têm falta e
        // quantos alunos faltaram.
        // Turma cujos alunos vieram todos os dias não aparece no accordion, então
        // também não pode entrar na contagem — senão o título prometeria mais
        // turmas do que a tela mostra.
        const alunosComFalta = (dadosTurma) => Array.from(dadosTurma.alunos.values()).filter((a) => a.totalFaltas > 0);
        const turmasComFalta = Array.from(turmas.values()).filter((dadosTurma) => alunosComFalta(dadosTurma).length > 0);
        const totalAlunos = turmasComFalta.reduce((soma, dadosTurma) => soma + alunosComFalta(dadosTurma).length, 0);

        document.getElementById('totalResultado').textContent =
          `(${turmasComFalta.length} turma(s), ${totalAlunos} aluno(s) com falta${!dataInicio && !turma && resposta.total >= 100 ? ' — mostrando só os 100 lançamentos mais recentes, filtre por período' : ''})`;

        statusEl.classList.add('d-none');
        cardResultado.classList.remove('d-none');

      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'alert alert-warning';
          statusEl.textContent = 'Não foi possível carregar os lançamentos agora.';
        }
      }
    }

    // O projeto não carrega o bootstrap.bundle.js (só o CSS), então o toggle
    // do accordion precisa ser feito manualmente aqui.
    document.getElementById('accordionFaltas').addEventListener('click', (evento) => {
      // Clique na linha do aluno abre/fecha o detalhe dos dias e UCs. O link do
      // WhatsApp fica de fora, senão abrir a conversa também mexeria no detalhe.
      const linhaAluno = evento.target.closest('tr.linha-aluno');
      if (linhaAluno && !evento.target.closest('a')) {
        const detalhe = document.getElementById(linhaAluno.dataset.detalhe);
        const abrir = detalhe.classList.contains('d-none');
        detalhe.classList.toggle('d-none', !abrir);
        const icone = linhaAluno.querySelector('.icone-detalhe');
        icone.classList.toggle('bi-chevron-right', !abrir);
        icone.classList.toggle('bi-chevron-down', abrir);
        return;
      }

      const botao = evento.target.closest('.accordion-button');
      if (!botao) return;

      const alvo = document.querySelector(botao.getAttribute('data-bs-target'));
      const jaAberto = botao.classList.contains('collapsed') === false;

      document.querySelectorAll('#accordionFaltas .accordion-button').forEach((b) => b.classList.add('collapsed'));
      document.querySelectorAll('#accordionFaltas .accordion-collapse').forEach((c) => c.classList.remove('show'));

      if (!jaAberto) {
        botao.classList.remove('collapsed');
        alvo.classList.add('show');
      }
    });

    // Padrão: do dia 1 do mês atual até hoje.
    function dataIsoLocal(date) {
      const ano = date.getFullYear();
      const mes = String(date.getMonth() + 1).padStart(2, '0');
      const dia = String(date.getDate()).padStart(2, '0');
      return `${ano}-${mes}-${dia}`;
    }
    function definirPeriodoPadrao() {
      const hoje = new Date();
      const inicioMes = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
      document.getElementById('filtroDataInicio').value = dataIsoLocal(inicioMes);
      document.getElementById('filtroDataFim').value = dataIsoLocal(hoje);
    }

    document.getElementById('formFiltro').addEventListener('submit', (evento) => {
      evento.preventDefault();
      carregarFaltas(
        document.getElementById('filtroDataInicio').value,
        document.getElementById('filtroDataFim').value,
        document.getElementById('filtroTurma').value
      );
    });
    document.getElementById('btnLimparFiltro').addEventListener('click', () => {
      definirPeriodoPadrao();
      document.getElementById('filtroTurma').value = '';
      document.getElementById('filtroIncluirEncerradas').checked = false;
      preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi, false);
      carregarFaltas(document.getElementById('filtroDataInicio').value, document.getElementById('filtroDataFim').value, '');
    });

    // Marcar/desmarcar repopula o select (as encerradas entram ou saem da lista)
    // e recarrega com o mesmo período.
    document.getElementById('filtroIncluirEncerradas').addEventListener('change', async () => {
      await preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi, incluirEncerradas());
      carregarFaltas(
        document.getElementById('filtroDataInicio').value,
        document.getElementById('filtroDataFim').value,
        document.getElementById('filtroTurma').value
      );
    });

    preencherSelectTurmas(document.getElementById('filtroTurma'), chamarApi, false);
    definirPeriodoPadrao();
    carregarFaltas(document.getElementById('filtroDataInicio').value, document.getElementById('filtroDataFim').value, '');
  </script>
</body>

</html>