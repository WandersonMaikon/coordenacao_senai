<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('partials/head', { titulo: 'WhatsApp' }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <div class="page-layout">

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { paginaAtual: 'whatsapp' }) %>

    <main class="app-wrapper">
      <div class="container-fluid">

        <div class="app-page-head d-flex flex-wrap gap-3 align-items-center justify-content-between">
          <div class="clearfix">
            <h1 class="app-page-title">WhatsApp</h1>
            <span>O número do sistema manda mensagem sozinho para os alunos que entram em risco</span>
          </div>
        </div>

        <%# Atendimento individual entra na etapa 4 — ver o roadmap item 7 no CLAUDE.md. O Bootstrap JS não é carregado no projeto, então
            a troca de aba é feita no script lá embaixo (data-aba). %>
        <ul class="nav nav-tabs mb-4" id="abas">
          <li class="nav-item"><a class="nav-link" href="#numero" data-aba="numero"><i class="bi bi-phone me-1"></i>Meu número</a></li>
          <li class="nav-item"><a class="nav-link" href="#mensagem" data-aba="mensagem"><i class="bi bi-chat-text me-1"></i>Mensagem e limites</a></li>
          <li class="nav-item"><a class="nav-link" href="#envio" data-aba="envio"><i class="bi bi-robot me-1"></i>Envio automático</a></li>
          <li class="nav-item"><span class="nav-link disabled" title="Disponível na próxima etapa">Atendimento individual</span></li>
          <li class="nav-item"><a class="nav-link" href="#historico" data-aba="historico"><i class="bi bi-clock-history me-1"></i>Histórico</a></li>
        </ul>

        <div id="avisoNaoConfigurado" class="alert alert-warning d-none">
          <i class="bi bi-exclamation-triangle-fill me-1"></i>
          O WhatsApp ainda não foi configurado no servidor (serviço OpenWA). Fale com o administrador do sistema.
        </div>

        <div class="alert alert-light border small">
          <i class="bi bi-info-circle me-1"></i>
          O envio usa o WhatsApp Web de forma <strong>não oficial</strong>. Existe risco de o WhatsApp
          restringir ou bloquear o número, principalmente se muitas mensagens forem enviadas em pouco
          tempo. Os limites de envio existem para reduzir esse risco. Se usar o seu número pessoal,
          considere um chip da escola.
        </div>

        <div data-painel="numero" hidden>
        <div class="row g-4">
          <div class="col-lg-5">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="mb-3">Número cadastrado</h5>
                <form id="formNumero">
                  <div class="mb-3">
                    <label class="form-label" for="campoTelefone">Número do WhatsApp (com DDD)</label>
                    <input type="tel" class="form-control" id="campoTelefone" placeholder="(69) 99999-9999" required>
                  </div>
                  <div class="mb-3">
                    <label class="form-label d-block">Tipo do número</label>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="radio" name="tipo" id="tipoPessoal" value="pessoal" checked>
                      <label class="form-check-label" for="tipoPessoal">Pessoal</label>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="radio" name="tipo" id="tipoInstitucional" value="institucional">
                      <label class="form-check-label" for="tipoInstitucional">Chip da escola</label>
                    </div>
                  </div>
                  <button type="submit" class="btn btn-primary" id="btnSalvarNumero">Salvar número</button>
                  <span id="statusNumero" class="ms-2 small"></span>
                </form>
              </div>
            </div>
          </div>

          <div class="col-lg-7">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="mb-3">Conexão</h5>

                <div id="estadoConexao" class="mb-3"></div>

                <div id="blocoQr" class="text-center d-none mb-3">
                  <img id="imagemQr" alt="QR code para conectar o WhatsApp" style="width: 260px; max-width: 100%;">
                  <ol class="text-start small text-body-secondary mt-3 mb-0 mx-auto" style="max-width: 360px;">
                    <li>Abra o WhatsApp no celular do número cadastrado</li>
                    <li>Toque em <strong>Configurações › Aparelhos conectados</strong></li>
                    <li>Toque em <strong>Conectar um aparelho</strong> e aponte para este código</li>
                  </ol>
                </div>

                <div class="d-flex flex-wrap gap-2">
                  <button type="button" class="btn btn-success" id="btnConectar"><i class="bi bi-qr-code me-1"></i>Conectar WhatsApp</button>
                  <button type="button" class="btn btn-outline-danger d-none" id="btnDesconectar"><i class="bi bi-x-circle me-1"></i>Desconectar</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        </div>

        <!-- ───────────── Mensagem e limites ───────────── -->
        <div data-painel="mensagem" hidden>
          <form id="formConfig">
            <div class="row g-4">
              <div class="col-lg-7">
                <div class="card h-100">
                  <div class="card-body">
                    <h5 class="mb-1">Mensagem</h5>
                    <p class="text-body-secondary small mb-3">
                      Clique numa variável para inserir no ponto do cursor — ela é trocada pelos dados de cada aluno.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-2" id="botoesVariaveis"></div>
                    <textarea class="form-control" id="campoMensagem" rows="7" maxlength="1000"></textarea>
                    <div class="d-flex justify-content-between small mt-1">
                      <button type="button" class="btn btn-link btn-sm p-0" id="btnMensagemPadrao">Restaurar mensagem padrão</button>
                      <span class="text-body-secondary" id="contadorMensagem"></span>
                    </div>

                    <h6 class="mt-4 mb-2">Como o aluno vai receber</h6>
                    <p class="text-body-secondary small mb-2">
                      Exemplo com uma aluna fictícia. O convite para responder e o "SAIR" são
                      <strong>adicionados automaticamente</strong> no final. O aluno responde com as palavras
                      dele: o sistema lê a resposta e <strong>sugere</strong> o motivo da falta, que a
                      coordenação confirma na tela de Alunos em risco.
                    </p>
                    <div class="p-3 rounded-3 small" id="previaMensagem"
                         style="background: #dcf8c6; color: #111; white-space: pre-wrap; max-width: 34rem;"></div>
                  </div>
                </div>
              </div>

              <div class="col-lg-5">
                <div class="card h-100">
                  <div class="card-body">
                    <h5 class="mb-1">Limites de envio</h5>
                    <p class="text-body-secondary small mb-3">
                      Protegem o seu número de bloqueio. Quanto mais devagar, menor o risco.
                    </p>

                    <div id="avisoAquecimento" class="alert alert-warning small py-2 d-none"></div>

                    <label class="form-label">Intervalo entre mensagens (segundos)</label>
                    <div class="row g-2 mb-1">
                      <div class="col">
                        <div class="input-group">
                          <span class="input-group-text">mín.</span>
                          <input type="number" class="form-control" id="campoIntervaloMin" min="60" step="1" required>
                        </div>
                      </div>
                      <div class="col">
                        <div class="input-group">
                          <span class="input-group-text">máx.</span>
                          <input type="number" class="form-control" id="campoIntervaloMax" min="60" step="1" required>
                        </div>
                      </div>
                    </div>
                    <p class="small text-body-secondary mb-3" id="textoIntervalo">
                      Cada mensagem sai num tempo sorteado entre o mínimo e o máximo — um ritmo fixo parece robô.
                    </p>

                    <div class="row g-2 mb-3">
                      <div class="col">
                        <label class="form-label" for="campoLimiteDia">Máximo por dia</label>
                        <input type="number" class="form-control" id="campoLimiteDia" min="1" step="1" required>
                      </div>
                      <div class="col">
                        <label class="form-label" for="campoLimiteMes">Máximo por mês</label>
                        <input type="number" class="form-control" id="campoLimiteMes" min="1" step="1" required>
                      </div>
                    </div>

                    <label class="form-label">Horário de envio</label>
                    <div class="row g-2 mb-1">
                      <div class="col">
                        <div class="input-group">
                          <span class="input-group-text">das</span>
                          <input type="time" class="form-control" id="campoJanelaInicio" required>
                        </div>
                      </div>
                      <div class="col">
                        <div class="input-group">
                          <span class="input-group-text">às</span>
                          <input type="time" class="form-control" id="campoJanelaFim" required>
                        </div>
                      </div>
                    </div>
                    <p class="small text-body-secondary mb-4">De segunda a sábado. Fora desse horário o envio espera.</p>

                    <p class="small text-body-secondary mb-3" id="textoTetos"></p>

                    <button type="submit" class="btn btn-primary" id="btnSalvarConfig">Salvar mensagem e limites</button>
                    <span id="statusConfig" class="ms-2 small"></span>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>

        <!-- ───────────── Envio automático ───────────── -->
        <div data-painel="envio" hidden>
          <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
              <div class="card h-100">
                <div class="card-body">
                  <div class="small text-body-secondary mb-1">Número do sistema</div>
                  <div id="envioConexao">—</div>
                </div>
              </div>
            </div>
            <div class="col-md-3 col-xl-4">
              <div class="card h-100">
                <div class="card-body">
                  <div class="small text-body-secondary mb-1">Enviadas hoje</div>
                  <div class="fs-4 fw-semibold" id="envioUsoHoje">—</div>
                  <div class="progress mt-2" style="height: 6px;"><div class="progress-bar" id="envioBarraHoje" style="width: 0%"></div></div>
                </div>
              </div>
            </div>
            <div class="col-md-3 col-xl-4">
              <div class="card h-100">
                <div class="card-body">
                  <div class="small text-body-secondary mb-1">Enviadas no mês</div>
                  <div class="fs-4 fw-semibold" id="envioUsoMes">—</div>
                  <div class="progress mt-2" style="height: 6px;"><div class="progress-bar" id="envioBarraMes" style="width: 0%"></div></div>
                </div>
              </div>
            </div>
          </div>

          <div class="card mb-4">
            <div class="card-body" id="areaControle">
              <p class="text-body-secondary mb-0">Carregando...</p>
            </div>
          </div>

          <div class="card mb-4">
            <div class="card-body" id="areaCobertura"></div>
          </div>

          <div class="card">
            <div class="card-body" id="areaEnvio"></div>
          </div>
        </div>

        <!-- ───────────── Histórico ───────────── -->
        <div data-painel="historico" hidden>
          <div class="card">
            <div class="card-body">
              <h5 class="mb-1">Histórico de mensagens</h5>
              <p class="text-body-secondary small mb-3">Todas as mensagens automáticas, de todos os usuários.</p>
              <form id="formHistorico" class="row g-2 align-items-end mb-3">
                <div class="col-auto">
                  <label class="form-label small" for="historicoTurma">Turma</label>
                  <select class="form-select form-select-sm" id="historicoTurma"><option value="">Todas</option></select>
                </div>
                <div class="col-auto">
                  <label class="form-label small" for="historicoUsuario">Enviado por</label>
                  <select class="form-select form-select-sm" id="historicoUsuario"><option value="">Todos</option></select>
                </div>
                <div class="col-auto">
                  <label class="form-label small" for="historicoStatus">Situação</label>
                  <select class="form-select form-select-sm" id="historicoStatus">
                    <option value="">Todas</option>
                    <option value="enviada">Enviadas</option>
                    <option value="pendente">Na fila</option>
                    <option value="falhou">Falharam</option>
                    <option value="cancelada">Canceladas</option>
                  </select>
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Filtrar</button>
                </div>
              </form>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Quando</th>
                      <th>Aluno</th>
                      <th>Turma</th>
                      <th>Enviado por</th>
                      <th>Situação</th>
                    </tr>
                  </thead>
                  <tbody id="tabelaHistorico"></tbody>
                </table>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 small">
                <span class="text-body-secondary" id="historicoResumo"></span>
                <div class="btn-group">
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="historicoAnterior">Anterior</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="historicoProxima">Próxima</button>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>

  </div>

  <script src="/js/turmas.js"></script>
  <script>
    const token = localStorage.getItem('coor360_token');

    if (!token) {
      window.location.href = '/login';
    }

    function sair() {
      localStorage.removeItem('coor360_token');
      window.location.href = '/login';
    }
    document.getElementById('btnSair').addEventListener('click', sair);
    document.getElementById('btnSairMenu').addEventListener('click', sair);

    const html = document.documentElement;

    document.getElementById('btnToggleMenu').addEventListener('click', function () {
      this.classList.toggle('active');
      if (window.matchMedia('(max-width: 1199.98px)').matches) {
        document.getElementById('menubar').classList.toggle('open');
      } else if (html.getAttribute('data-app-sidebar') === 'mini') {
        html.removeAttribute('data-app-sidebar');
      } else {
        html.setAttribute('data-app-sidebar', 'mini');
      }
    });

    const btnTema = document.getElementById('btnTema');
    function aplicarTema(tema) {
      html.setAttribute('data-bs-theme', tema);
      btnTema.classList.toggle('active', tema === 'dark');
    }
    aplicarTema(localStorage.getItem('coor360_tema') || 'light');
    btnTema.addEventListener('click', () => {
      const atual = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      aplicarTema(atual);
      localStorage.setItem('coor360_tema', atual);
    });

    function escaparHtml(texto) {
      return String(texto ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    // "69993408643" → "(69) 99340-8643"; o OpenWA reporta com 55 na frente.
    function formatarTelefone(telefone) {
      let digitos = String(telefone || '').replace(/\D/g, '');
      if (digitos.length >= 12 && digitos.startsWith('55')) digitos = digitos.slice(2);
      // O WhatsApp reporta alguns celulares sem o 9º dígito (69 9230-6863): celular
      // começa com 6-9 depois do DDD, então devolve o 9 só na exibição.
      if (digitos.length === 10 && /[6-9]/.test(digitos[2])) digitos = `${digitos.slice(0, 2)}9${digitos.slice(2)}`;
      if (digitos.length === 11) return `(${digitos.slice(0, 2)}) ${digitos.slice(2, 7)}-${digitos.slice(7)}`;
      if (digitos.length === 10) return `(${digitos.slice(0, 2)}) ${digitos.slice(2, 6)}-${digitos.slice(6)}`;
      return digitos;
    }

    async function chamarApi(caminho, opcoes = {}) {
      const resposta = await fetch(caminho, {
        ...opcoes,
        headers: {
          Authorization: 'Bearer ' + token,
          ...(opcoes.body ? { 'Content-Type': 'application/json' } : {})
        }
      });
      if (resposta.status === 401) {
        localStorage.removeItem('coor360_token');
        window.location.href = '/login';
        throw new Error('Sessão expirada');
      }
      // Quando o backend está reiniciando ou demora demais, quem responde é o
      // Cloudflare, com uma página HTML — sem isto a tela mostraria só
      // "Unexpected token '<'".
      if (!(resposta.headers.get('content-type') || '').includes('application/json')) {
        throw new Error(`O servidor não respondeu como esperado (HTTP ${resposta.status}). Aguarde alguns segundos e tente de novo.`);
      }
      return resposta.json();
    }

    // Rótulos dos status do OpenWA pra quem não é técnico.
    const STATUS_SESSAO = {
      created: { rotulo: 'Preparando', cor: 'secondary' },
      initializing: { rotulo: 'Iniciando o WhatsApp no servidor…', cor: 'info' },
      qr_ready: { rotulo: 'Aguardando leitura do QR code', cor: 'warning' },
      authenticating: { rotulo: 'Conectando…', cor: 'info' },
      ready: { rotulo: 'Conectado', cor: 'success' },
      disconnected: { rotulo: 'Desconectado', cor: 'danger' },
      action_required: { rotulo: 'Precisa de ação no celular', cor: 'danger' },
      failed: { rotulo: 'Falhou', cor: 'danger' }
    };

    let dadosAtuais = null;
    let timerSessao = null;

    function pararAcompanhamento() {
      if (timerSessao) clearTimeout(timerSessao);
      timerSessao = null;
    }

    function desenharNumero(dados) {
      dadosAtuais = dados;
      if (dados.telefone && document.activeElement !== document.getElementById('campoTelefone')) {
        document.getElementById('campoTelefone').value = formatarTelefone(dados.telefone);
      }
      document.getElementById(dados.tipo === 'institucional' ? 'tipoInstitucional' : 'tipoPessoal').checked = true;
      document.getElementById('btnSalvarNumero').textContent = dados.telefone ? 'Salvar / trocar número' : 'Salvar número';
    }

    function desenharConexao(dados, qrCode, erroSessao, avisoWebhook) {
      const estado = document.getElementById('estadoConexao');
      const btnConectar = document.getElementById('btnConectar');
      const btnDesconectar = document.getElementById('btnDesconectar');
      const blocoQr = document.getElementById('blocoQr');

      const info = dados.status ? (STATUS_SESSAO[dados.status] || { rotulo: dados.status, cor: 'secondary' }) : null;
      const linhas = [];

      if (!dados.telefone) {
        linhas.push('<p class="text-body-secondary mb-0">Cadastre o seu número ao lado para poder conectar.</p>');
      } else if (!dados.temSessao) {
        linhas.push('<span class="badge bg-secondary-subtle text-secondary-emphasis border">Não conectado</span>');
      } else {
        linhas.push(`<span class="badge bg-${info.cor}-subtle text-${info.cor}-emphasis border border-${info.cor}-subtle">${escaparHtml(info.rotulo)}</span>`);
      }

      if (dados.status === 'ready' && dados.telefoneConectado) {
        linhas.push(`<div class="mt-2">Número conectado: <strong>${formatarTelefone(dados.telefoneConectado)}</strong></div>`);
      }
      if (dados.numeroConfere === false) {
        linhas.push(`<div class="alert alert-danger py-2 mt-2 mb-0 small"><i class="bi bi-exclamation-triangle-fill me-1"></i>O WhatsApp conectado (${formatarTelefone(dados.telefoneConectado)}) não é o número cadastrado (${formatarTelefone(dados.telefone)}). Desconecte e leia o QR com o celular certo, ou corrija o número cadastrado.</div>`);
      }
      if (dados.pausadoMotivo && dados.numeroConfere !== false) {
        linhas.push(`<div class="alert alert-warning py-2 mt-2 mb-0 small"><i class="bi bi-pause-circle-fill me-1"></i>${escaparHtml(dados.pausadoMotivo)}</div>`);
      }
      if (erroSessao && dados.status !== 'ready') {
        linhas.push(`<div class="small text-danger mt-2">${escaparHtml(erroSessao)}</div>`);
      }
      // O número pode estar conectado e mandando mensagem com o caminho de volta
      // quebrado — foi o que aconteceu. Sem este aviso, a tela dizia "conectado"
      // e as respostas dos alunos eram descartadas sem ninguém saber.
      if (avisoWebhook) {
        linhas.push(`<div class="alert alert-warning py-2 mt-2 mb-0 small"><i class="bi bi-arrow-down-left-circle-fill me-1"></i><strong>As respostas dos alunos não estão chegando.</strong><div class="mt-1">${escaparHtml(avisoWebhook)}</div></div>`);
      }
      estado.innerHTML = linhas.join('');

      blocoQr.classList.toggle('d-none', !qrCode);
      if (qrCode) document.getElementById('imagemQr').src = qrCode;

      const conectado = dados.temSessao && ['ready', 'authenticating', 'qr_ready', 'initializing', 'created'].includes(dados.status);
      btnConectar.classList.toggle('d-none', conectado || !dados.telefone);
      btnDesconectar.classList.toggle('d-none', !dados.temSessao);
    }

    // Enquanto o número não está pronto, consulta a cada 3s pra trocar o QR
    // (ele expira) e perceber quando o celular leu o código.
    async function acompanharSessao() {
      pararAcompanhamento();
      try {
        const resposta = await chamarApi('/whatsapp/sessao');
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
        document.getElementById('avisoNaoConfigurado').classList.toggle('d-none', resposta.configurado !== false);
        desenharNumero(resposta.dados);
        desenharConexao(resposta.dados, resposta.qrCode, resposta.erroSessao, resposta.avisoWebhook);
        // Sem OpenWA configurado o botão só levaria a um erro — a faixa amarela já explica.
        const btnConectar = document.getElementById('btnConectar');
        btnConectar.disabled = resposta.configurado === false;
        btnConectar.title = resposta.configurado === false ? 'O WhatsApp ainda não foi configurado no servidor' : '';

        const emAndamento = resposta.dados.temSessao && ['created', 'initializing', 'qr_ready', 'authenticating'].includes(resposta.dados.status);
        if (emAndamento) timerSessao = setTimeout(acompanharSessao, 3000);
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          document.getElementById('estadoConexao').innerHTML =
            `<div class="alert alert-warning py-2 mb-0 small">Não foi possível consultar o WhatsApp agora: ${escaparHtml(erro.message)}</div>`;
        }
      }
    }

    document.getElementById('formNumero').addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const statusEl = document.getElementById('statusNumero');
      const telefone = document.getElementById('campoTelefone').value;
      const tipo = document.querySelector('input[name="tipo"]:checked').value;

      const digitosNovos = telefone.replace(/\D/g, '').replace(/^55(?=\d{10,11}$)/, '');
      if (dadosAtuais?.telefone && dadosAtuais.telefone !== digitosNovos && dadosAtuais.temSessao) {
        const confirmacao = await Swal.fire({
          title: 'Trocar o número?',
          text: 'O WhatsApp conectado hoje será desconectado e você vai precisar ler o QR code com o celular do novo número.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'Trocar número',
          cancelButtonText: 'Cancelar'
        });
        if (!confirmacao.isConfirmed) return;
      }

      statusEl.className = 'ms-2 small text-body';
      statusEl.textContent = 'Salvando...';
      try {
        const resposta = await chamarApi('/whatsapp/meu-numero', { method: 'PUT', body: JSON.stringify({ telefone, tipo }) });
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
        statusEl.className = 'ms-2 small text-success';
        statusEl.textContent = resposta.mensagem;
        notificar.ok(resposta.mensagem);
        document.getElementById('campoTelefone').blur();
        await acompanharSessao();
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'ms-2 small text-danger';
          statusEl.textContent = erro.message || 'Não foi possível salvar.';
          notificar.erro(erro.message || 'Não foi possível salvar o número.');
        }
      }
    });

    document.getElementById('btnConectar').addEventListener('click', async () => {
      const botao = document.getElementById('btnConectar');
      botao.disabled = true;
      try {
        const resposta = await chamarApi('/whatsapp/sessao/conectar', { method: 'POST' });
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          Swal.fire({ title: 'Não foi possível conectar', text: erro.message, icon: 'error' });
        }
      }
      // acompanharSessao decide se o botão fica habilitado (depende de o servidor
      // estar configurado), por isso vem por último.
      botao.disabled = false;
      await acompanharSessao();
    });

    document.getElementById('btnDesconectar').addEventListener('click', async () => {
      const confirmacao = await Swal.fire({
        title: 'Desconectar o WhatsApp?',
        text: 'Os envios por este número param. O número continua cadastrado e pode ser conectado de novo.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Desconectar',
        cancelButtonText: 'Cancelar'
      });
      if (!confirmacao.isConfirmed) return;

      pararAcompanhamento();
      try {
        const resposta = await chamarApi('/whatsapp/sessao/desconectar', { method: 'POST' });
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
        notificar.ok('WhatsApp desconectado. O número segue cadastrado.');
        await acompanharSessao();
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          Swal.fire({ title: 'Não foi possível desconectar', text: erro.message, icon: 'error' });
        }
      }
    });

    // ───────────── Mensagem e limites ─────────────

    let mensagemPadrao = '';
    let timerPreviaMensagem = null;

    function formatarDuracao(segundos) {
      const min = Math.floor(segundos / 60);
      const seg = segundos % 60;
      if (min === 0) return `${seg} s`;
      return seg ? `${min} min ${seg} s` : `${min} min`;
    }

    function atualizarTextosLimites() {
      const min = Number(document.getElementById('campoIntervaloMin').value);
      const max = Number(document.getElementById('campoIntervaloMax').value);
      if (min && max) {
        document.getElementById('textoIntervalo').textContent =
          `Cada mensagem sai entre ${formatarDuracao(min)} e ${formatarDuracao(max)} depois da anterior, num tempo sorteado — um ritmo fixo parece robô.`;
      }
      const campo = document.getElementById('campoMensagem');
      document.getElementById('contadorMensagem').textContent = `${campo.value.length}/${campo.maxLength}`;
    }

    async function atualizarPreviaMensagem() {
      try {
        const resposta = await chamarApi('/whatsapp/config/previa', {
          method: 'POST',
          body: JSON.stringify({ mensagemModelo: document.getElementById('campoMensagem').value })
        });
        if (resposta.status === 'ok') document.getElementById('previaMensagem').textContent = resposta.texto;
      } catch (erro) {
        // A prévia é só conforto visual; se falhar, o salvar ainda funciona.
      }
    }

    function agendarPreviaMensagem() {
      atualizarTextosLimites();
      clearTimeout(timerPreviaMensagem);
      timerPreviaMensagem = setTimeout(atualizarPreviaMensagem, 500);
    }

    function preencherConfig(dados) {
      document.getElementById('campoMensagem').value = dados.mensagemModelo;
      document.getElementById('campoIntervaloMin').value = dados.intervaloMinSeg;
      document.getElementById('campoIntervaloMax').value = dados.intervaloMaxSeg;
      document.getElementById('campoLimiteDia').value = dados.limiteDia;
      document.getElementById('campoLimiteMes').value = dados.limiteMes;
      document.getElementById('campoJanelaInicio').value = dados.janelaInicio;
      document.getElementById('campoJanelaFim').value = dados.janelaFim;
      atualizarTextosLimites();
      atualizarPreviaMensagem();
    }

    async function carregarConfig() {
      try {
        const resposta = await chamarApi('/whatsapp/config');
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
        const { tetos, aquecimento } = resposta;

        document.getElementById('botoesVariaveis').innerHTML = resposta.variaveis
          .map((v) => `<button type="button" class="btn btn-sm btn-outline-secondary" data-variavel="${v}">${v}</button>`)
          .join('');

        document.getElementById('textoTetos').textContent =
          `Limites máximos do sistema: intervalo mínimo de ${formatarDuracao(tetos.intervaloMinSeg)}, até ${tetos.limiteDiaMax} mensagens por dia e ${tetos.limiteMesMax} por mês, entre ${tetos.janelaMaisCedo} e ${tetos.janelaMaisTarde}.`;

        const aviso = document.getElementById('avisoAquecimento');
        aviso.classList.toggle('d-none', !resposta.dados.emAquecimento);
        aviso.innerHTML = `<i class="bi bi-thermometer-half me-1"></i>Número novo: nos primeiros ${aquecimento.dias} dias depois de conectar, o sistema envia no máximo <strong>${aquecimento.limiteDia} por dia</strong>, mesmo que o limite abaixo seja maior.`;

        mensagemPadrao = resposta.mensagemPadrao;
        preencherConfig(resposta.dados);
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          document.getElementById('statusConfig').className = 'ms-2 small text-danger';
          document.getElementById('statusConfig').textContent = `Não foi possível carregar: ${erro.message}`;
        }
      }
    }

    document.getElementById('botoesVariaveis').addEventListener('click', (evento) => {
      const botao = evento.target.closest('[data-variavel]');
      if (!botao) return;
      const campo = document.getElementById('campoMensagem');
      const inicio = campo.selectionStart ?? campo.value.length;
      const fim = campo.selectionEnd ?? campo.value.length;
      campo.value = campo.value.slice(0, inicio) + botao.dataset.variavel + campo.value.slice(fim);
      campo.focus();
      campo.selectionStart = campo.selectionEnd = inicio + botao.dataset.variavel.length;
      agendarPreviaMensagem();
    });

    document.getElementById('campoMensagem').addEventListener('input', agendarPreviaMensagem);
    ['campoIntervaloMin', 'campoIntervaloMax'].forEach((id) =>
      document.getElementById(id).addEventListener('input', atualizarTextosLimites));

    document.getElementById('btnMensagemPadrao').addEventListener('click', () => {
      if (!mensagemPadrao) return;
      document.getElementById('campoMensagem').value = mensagemPadrao;
      agendarPreviaMensagem();
    });

    document.getElementById('formConfig').addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const statusEl = document.getElementById('statusConfig');
      statusEl.className = 'ms-2 small text-body';
      statusEl.textContent = 'Salvando...';
      try {
        const resposta = await chamarApi('/whatsapp/config', {
          method: 'PUT',
          body: JSON.stringify({
            mensagemModelo: document.getElementById('campoMensagem').value,
            intervaloMinSeg: Number(document.getElementById('campoIntervaloMin').value),
            intervaloMaxSeg: Number(document.getElementById('campoIntervaloMax').value),
            limiteDia: Number(document.getElementById('campoLimiteDia').value),
            limiteMes: Number(document.getElementById('campoLimiteMes').value),
            janelaInicio: document.getElementById('campoJanelaInicio').value,
            janelaFim: document.getElementById('campoJanelaFim').value
          })
        });
        if (resposta.status !== 'ok') throw new Error(resposta.mensagem);
        statusEl.className = 'ms-2 small text-success';
        statusEl.textContent = resposta.mensagem;
        notificar.ok(resposta.mensagem);
        preencherConfig(resposta.dados);
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          statusEl.className = 'ms-2 small text-danger';
          statusEl.textContent = erro.message;
          notificar.erro(erro.message || 'Não foi possível salvar a mensagem e os limites.');
        }
      }
    });

    // ───────────── Envio automático ─────────────

    const STATUS_MENSAGEM = {
      pendente: { rotulo: 'Na fila', cor: 'secondary', icone: 'hourglass-split' },
      enviando: { rotulo: 'Enviando…', cor: 'info', icone: 'arrow-repeat' },
      enviada: { rotulo: 'Enviada', cor: 'success', icone: 'check' },
      entregue: { rotulo: 'Entregue', cor: 'success', icone: 'check-all' },
      lida: { rotulo: 'Lida', cor: 'primary', icone: 'check-all' },
      falhou: { rotulo: 'Falhou', cor: 'danger', icone: 'x-circle' },
      cancelada: { rotulo: 'Cancelada', cor: 'warning', icone: 'slash-circle' }
    };

    function badgeMensagem(status, erro) {
      const s = STATUS_MENSAGEM[status] || { rotulo: status, cor: 'secondary', icone: 'dot' };
      return `<span class="badge bg-${s.cor}-subtle text-${s.cor}-emphasis border border-${s.cor}-subtle" ${erro ? `title="${escaparHtml(erro)}"` : ''}><i class="bi bi-${s.icone} me-1"></i>${s.rotulo}</span>`
        + (erro ? `<div class="small text-body-secondary mt-1">${escaparHtml(erro)}</div>` : '');
    }

    function formatarDataHora(dataIso) {
      return new Date(dataIso).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    let estadoEnvio = null;       // última resposta de /whatsapp/automatico
    let diferencaRelogio = 0;     // relógio do servidor − relógio do navegador
    let timerEnvio = null;
    let timerContagem = null;
    let controleDesenhado = false; // o formulário de turmas não é redesenhado a cada consulta
    let turmasDisponiveis = null;

    function pararAtualizacaoEnvio() {
      clearInterval(timerEnvio);
      clearInterval(timerContagem);
      timerEnvio = timerContagem = null;
    }

    function desenharResumoEnvio(r) {
      const conexao = document.getElementById('envioConexao');
      const pct = (valor, limite) => `${Math.min(100, Math.round((valor / Math.max(1, limite)) * 100))}%`;
      if (!r.sistema) {
        conexao.innerHTML = '<span class="badge bg-secondary-subtle text-secondary-emphasis border">Nenhum</span>';
        ['envioUsoHoje', 'envioUsoMes'].forEach((id) => { document.getElementById(id).textContent = '—'; });
        ['envioBarraHoje', 'envioBarraMes'].forEach((id) => { document.getElementById(id).style.width = '0%'; });
        return;
      }
      const sis = r.sistema;
      let estado;
      if (sis.pausadoMotivo) {
        estado = `
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-pause-circle-fill me-1"></i>Envio pausado</span>
          <div class="small mt-2">${escaparHtml(sis.pausadoMotivo)}</div>
          ${sis.souDono ? '<button type="button" class="btn btn-sm btn-warning mt-2" id="btnRetomar"><i class="bi bi-play-fill me-1"></i>Já resolvi — retomar</button>' : `<div class="small text-body-secondary mt-1">Quem resolve é ${escaparHtml(sis.dono)}, na aba Meu número.</div>`}`;
      } else if (sis.conectado) {
        estado = '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Conectado</span>';
      } else {
        estado = '<span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">Não conectado</span>';
      }
      conexao.innerHTML = `<div class="fw-semibold">${escaparHtml(sis.dono)}${sis.telefone ? ` · ${formatarTelefone(sis.telefone)}` : ''}</div><div class="mt-1">${estado}</div>`;

      document.getElementById('envioUsoHoje').textContent = `${r.uso.hoje} / ${r.uso.limiteDia}`;
      document.getElementById('envioBarraHoje').style.width = pct(r.uso.hoje, r.uso.limiteDia);
      document.getElementById('envioUsoMes').textContent = `${r.uso.mes} / ${r.uso.limiteMes}`;
      document.getElementById('envioBarraMes').style.width = pct(r.uso.mes, r.uso.limiteMes);
    }

    async function carregarTurmasDisponiveis() {
      if (turmasDisponiveis) return turmasDisponiveis;
      const resposta = await chamarApi('/turmas');
      turmasDisponiveis = (resposta.dados || [])
        .sort((a, b) => (nomeTurmaLimpo(a.nomeTurma) || a.codigoTurma).localeCompare(nomeTurmaLimpo(b.nomeTurma) || b.codigoTurma, 'pt-BR'));
      return turmasDisponiveis;
    }

    // Escolha das turmas: "todas" ou só as marcadas (piloto).
    function blocoTurmas(turmasEscolhidas, editavel) {
      const todas = !turmasEscolhidas;
      const escolhidas = new Set(turmasEscolhidas || []);
      const lista = turmasDisponiveis || [];
      if (!editavel) {
        return todas
          ? '<div>Envia para <strong>todas as turmas</strong>.</div>'
          : `<div>Envia só para estas turmas:</div><ul class="small mb-0">${(turmasEscolhidas || []).map((codigo) => {
              const turma = lista.find((t) => t.codigoTurma === codigo);
              return `<li>${escaparHtml(turma ? nomeTurmaLimpo(turma.nomeTurma) || codigo : codigo)} <span class="text-body-secondary">(${escaparHtml(codigo)})</span></li>`;
            }).join('')}</ul>`;
      }
      return `
        <div class="form-check">
          <input class="form-check-input" type="radio" name="escopoTurmas" id="escopoTodas" value="todas" ${todas ? 'checked' : ''}>
          <label class="form-check-label" for="escopoTodas">Todas as turmas</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="escopoTurmas" id="escopoAlgumas" value="algumas" ${todas ? '' : 'checked'}>
          <label class="form-check-label" for="escopoAlgumas">Só estas turmas <span class="text-body-secondary small">(bom para começar com um piloto)</span></label>
        </div>
        <div id="listaTurmasEscolha" class="border rounded-3 p-2 mt-2 small" style="max-height: 260px; overflow-y: auto;" ${todas ? 'hidden' : ''}>
          ${lista.length === 0 ? '<span class="text-body-secondary">Nenhuma turma encontrada.</span>' : lista.map((t) => `
            <div class="form-check">
              <input class="form-check-input caixa-turma" type="checkbox" id="turma_${escaparHtml(t.codigoTurma)}" value="${escaparHtml(t.codigoTurma)}" ${escolhidas.has(t.codigoTurma) ? 'checked' : ''}>
              <label class="form-check-label" for="turma_${escaparHtml(t.codigoTurma)}">${escaparHtml(nomeTurmaLimpo(t.nomeTurma) || t.codigoTurma)} <span class="text-body-secondary">(${escaparHtml(t.codigoTurma)})</span></label>
            </div>`).join('')}
        </div>`;
    }

    function turmasDoFormulario() {
      if (document.getElementById('escopoTodas')?.checked) return null;
      return [...document.querySelectorAll('.caixa-turma:checked')].map((caixa) => caixa.value);
    }

    function desenharControle() {
      const area = document.getElementById('areaControle');
      const r = estadoEnvio;
      const sis = r.sistema;
      const explicacao = `
        <p class="text-body-secondary small mb-3">
          Quando ligado, o sistema confere a lista de risco a cada 5 minutos e manda a mensagem sozinho para
          quem está em risco e ainda não recebeu, respeitando o horário e os limites do número. Cada aluno
          recebe no máximo uma mensagem automática por semana. Quem conversou com a coordenação nos últimos
          ${r.diasDesdeContato} dias não recebe; passado esse prazo, se continuar faltando, recebe.
        </p>`;

      if (!sis) {
        let acao;
        if (!r.minhaSessao.institucional) {
          acao = '<div class="alert alert-light border small mb-0"><i class="bi bi-info-circle me-1"></i>O envio automático usa um <strong>chip da escola</strong>, nunca um número pessoal. Para ligar, entre com o usuário do chip (por exemplo "whatsapp-1"), cadastre o número como <em>Chip da escola</em> na aba <a href="#numero" data-ir-aba="numero">Meu número</a> e conecte.</div>';
        } else if (!r.minhaSessao.conectado) {
          acao = '<div class="alert alert-light border small mb-0">Conecte o chip na aba <a href="#numero" data-ir-aba="numero">Meu número</a> para poder ligar o envio automático.</div>';
        } else {
          acao = `
            <h6 class="mb-2">Para quais turmas?</h6>
            ${blocoTurmas(null, true)}
            <button type="button" class="btn btn-success mt-3" id="btnLigarAutomatico"><i class="bi bi-power me-1"></i>Ligar envio automático com este número</button>`;
        }
        area.innerHTML = `
          <h5 class="mb-1">Envio automático desligado</h5>
          ${explicacao}
          ${acao}`;
        controleDesenhado = true;
        return;
      }

      area.innerHTML = `
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-1">
          <h5 class="mb-0"><span class="badge bg-success me-2"><i class="bi bi-power"></i></span>Envio automático ligado</h5>
          ${sis.podeAlterar ? '<button type="button" class="btn btn-outline-danger btn-sm" id="btnDesligarAutomatico"><i class="bi bi-stop-circle me-1"></i>Desligar</button>' : ''}
        </div>
        ${explicacao}
        <h6 class="mb-2">Turmas</h6>
        ${blocoTurmas(sis.turmas, sis.podeAlterar)}
        ${sis.podeAlterar ? '<button type="button" class="btn btn-primary btn-sm mt-3" id="btnSalvarTurmas">Salvar turmas</button>' : `<div class="small text-body-secondary mt-2">Só ${escaparHtml(sis.dono)} ou o administrador alteram o envio automático.</div>`}`;
      controleDesenhado = true;
    }

    function desenharCobertura() {
      const area = document.getElementById('areaCobertura');
      const r = estadoEnvio;
      if (!r.sistema) {
        area.innerHTML = '<h5 class="mb-1">Acompanhamento</h5><p class="text-body-secondary mb-0">Os números aparecem aqui quando o envio automático estiver ligado.</p>';
        return;
      }
      const { emRisco, porSituacao: p, responderam, prometeram, quebraram } = r.resumo;
      const pct = (n) => (emRisco ? Math.round((n / emRisco) * 100) : 0);
      const naFila = p.fila + p.receber;
      const naoPodem = p.sair + p.sem_whatsapp + p.sem_telefone + p.situacao;
      const coordenacao = p.contato_humano;

      const linha = (cor, rotulo, valor, detalhe = '') => `
        <tr>
          <td><span class="d-inline-block rounded-circle me-2 bg-${cor}" style="width: 10px; height: 10px;"></span>${rotulo}${detalhe ? `<div class="small text-body-secondary ms-4">${detalhe}</div>` : ''}</td>
          <td class="text-end fw-semibold">${valor}</td>
          <td class="text-end text-body-secondary small" style="width: 4rem;">${pct(valor)}%</td>
        </tr>`;
      const partes = (lista) => lista.filter(([, n]) => n > 0).map(([rotulo, n]) => `${rotulo}: ${n}`).join(' · ');

      let detalhes = '';
      if (r.promessasQuebradas.length) {
        detalhes += `
          <div class="alert alert-warning small mt-3 mb-0">
            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Prometeram voltar e faltaram de novo — precisam de contato de uma pessoa (<a href="/contatar">Precisam de contato</a>)</div>
            <ul class="mb-0">${r.promessasQuebradas.map((a) => `
              <li>${escaparHtml(a.nomeAluno || '—')} <span class="text-body-secondary">· ${escaparHtml(nomeTurmaLimpo(a.nomeTurma) || a.codigoTurma)} · prometeu em ${formatarDataHora(a.prometeuEm)}</span></li>`).join('')}
            </ul>
          </div>`;
      }
      if (r.naoRecebem.length) {
        detalhes += `
          <details class="mt-3">
            <summary class="small text-body-secondary">Ver os ${r.naoRecebem.length} aluno(s) que não recebem e o motivo</summary>
            <div class="table-responsive mt-2">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Aluno</th><th>Turma</th><th class="text-end">Sem vir</th><th>Motivo</th></tr></thead>
                <tbody>${r.naoRecebem.map((a) => `
                  <tr>
                    <td>${escaparHtml(a.nomeAluno || '—')}</td>
                    <td class="small">${escaparHtml(nomeTurmaLimpo(a.nomeTurma) || a.codigoTurma)}</td>
                    <td class="text-end">${a.diasSemVir}</td>
                    <td class="small">${escaparHtml(r.situacoes[a.situacao] || a.situacao)}</td>
                  </tr>`).join('')}
                </tbody>
              </table>
            </div>
          </details>`;
      }

      area.innerHTML = `
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
          <h5 class="mb-0">Acompanhamento</h5>
          <span class="text-body-secondary small">${emRisco} aluno(s) em risco ${r.sistema.turmas ? 'nas turmas escolhidas' : 'na escola'}</span>
        </div>
        <div class="fs-2 fw-semibold">${pct(p.enviada)}% <span class="fs-6 fw-normal text-body-secondary">já receberam a mensagem</span></div>
        <div class="progress my-3" style="height: 12px;">
          <div class="progress-bar bg-success" style="width: ${pct(p.enviada)}%" title="Mensagem enviada"></div>
          <div class="progress-bar bg-info" style="width: ${pct(naFila)}%" title="Na fila"></div>
          <div class="progress-bar bg-secondary" style="width: ${pct(coordenacao)}%" title="Com a coordenação"></div>
          <div class="progress-bar bg-warning" style="width: ${pct(naoPodem)}%" title="Não podem receber"></div>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <tbody>
              ${linha('success', 'Mensagem enviada', p.enviada, partes([['responderam', responderam], ['prometeram voltar', prometeram], ['prometeram e faltaram de novo', quebraram]]) || '0 respondeu(ram)')}
              ${linha('info', 'Na fila de envio', naFila)}
              ${linha('secondary', 'Com a coordenação', coordenacao, `falou com o aluno nos últimos ${r.diasDesdeContato} dias`)}
              ${linha('warning', 'Não podem receber WhatsApp', naoPodem, partes([['pediu SAIR', p.sair], ['sem WhatsApp / falha', p.sem_whatsapp], ['sem telefone', p.sem_telefone], ['situação não ativa', p.situacao]]))}
              ${p.semana ? linha('light', 'Já recebeu por outra turma nesta semana', p.semana) : ''}
            </tbody>
          </table>
        </div>
        ${detalhes}`;
    }

    // Linha de "o que está acontecendo agora", com contagem regressiva que anda
    // sozinha a cada segundo entre uma consulta e outra.
    function textoAgora() {
      const r = estadoEnvio;
      if (!r?.lote || r.lote.status !== 'em_andamento') return '';
      if (r.lote.aguardando) return `<i class="bi bi-hourglass-split me-1"></i>${escaparHtml(r.lote.aguardando)}`;
      if (r.proxima?.status === 'enviando') return `<i class="bi bi-arrow-repeat me-1"></i>Enviando para <strong>${escaparHtml(r.proxima.nomeAluno)}</strong>…`;
      if (!r.proxima) return '<i class="bi bi-check2-circle me-1"></i>Ninguém na fila agora.';
      const faltaMs = new Date(r.lote.proximoEnvioEm || 0).getTime() - (Date.now() + diferencaRelogio);
      if (faltaMs <= 0) return `<i class="bi bi-send me-1"></i>Preparando a mensagem para <strong>${escaparHtml(r.proxima.nomeAluno)}</strong>…`;
      const seg = Math.ceil(faltaMs / 1000);
      const texto = seg >= 60 ? `${Math.floor(seg / 60)}:${String(seg % 60).padStart(2, '0')}` : `${seg}s`;
      return `<i class="bi bi-clock me-1"></i>Próxima mensagem em <strong>${texto}</strong>, para ${escaparHtml(r.proxima.nomeAluno)}`;
    }

    function desenharMensagens() {
      const area = document.getElementById('areaEnvio');
      const r = estadoEnvio;
      if (!r.sistema) {
        area.innerHTML = '<h5 class="mb-1">Mensagens</h5><p class="text-body-secondary mb-0">Nenhum envio automático em andamento.</p>';
        return;
      }
      area.innerHTML = `
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
          <h5 class="mb-0">Últimas mensagens</h5>
          <a href="#historico" data-ir-aba="historico" class="small">ver o histórico completo</a>
        </div>
        ${r.lote?.status === 'em_andamento' ? `<div class="alert alert-light border py-2 small" id="textoAgora">${textoAgora()}</div>` : ''}
        ${r.mensagens.length === 0
          ? '<p class="text-body-secondary mb-0">Nenhuma mensagem ainda.</p>'
          : `
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Aluno</th><th>Turma</th><th>Situação</th><th class="text-end">Enviada em</th></tr></thead>
                <tbody>
                  ${r.mensagens.map((m) => `
                    <tr>
                      <td>${escaparHtml(m.nomeAluno || '—')}</td>
                      <td class="small">${escaparHtml(nomeTurmaLimpo(m.nomeTurma) || m.codigoTurma)}</td>
                      <td>${badgeMensagem(m.status, m.erro)}</td>
                      <td class="text-end small text-nowrap">${m.enviadaEm ? formatarDataHora(m.enviadaEm) : '—'}</td>
                    </tr>`).join('')}
                </tbody>
              </table>
            </div>`}`;
    }

    async function carregarEnvio(redesenharControle = false) {
      try {
        const [r] = await Promise.all([chamarApi('/whatsapp/automatico'), carregarTurmasDisponiveis()]);
        if (r.status !== 'ok') throw new Error(r.mensagem);
        // Ligou ou desligou em outra máquina: o formulário de turmas precisa mudar.
        const mudouEstado = Boolean(estadoEnvio?.sistema) !== Boolean(r.sistema);
        diferencaRelogio = new Date(r.agora).getTime() - Date.now();
        estadoEnvio = r;
        desenharResumoEnvio(r);
        if (redesenharControle || mudouEstado || !controleDesenhado) desenharControle();
        desenharCobertura();
        desenharMensagens();
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          document.getElementById('areaControle').innerHTML = `<p class="text-danger mb-0">Não foi possível carregar o envio automático: ${escaparHtml(erro.message)}</p>`;
        }
      }
    }

    // Consulta a cada 15s: a conta de cobertura recalcula o risco da escola inteira.
    function iniciarAtualizacaoEnvio() {
      pararAtualizacaoEnvio();
      carregarEnvio(true);
      timerEnvio = setInterval(() => carregarEnvio(false), 15000);
      timerContagem = setInterval(() => {
        const el = document.getElementById('textoAgora');
        if (el) el.innerHTML = textoAgora();
      }, 1000);
    }

    async function salvarAutomatico(ligado, botao) {
      const turmas = ligado ? turmasDoFormulario() : null;
      if (ligado && Array.isArray(turmas) && turmas.length === 0) {
        Swal.fire({ title: 'Escolha as turmas', text: 'Marque pelo menos uma turma, ou escolha "Todas as turmas".', icon: 'warning' });
        return;
      }
      botao.disabled = true;
      try {
        const r = await chamarApi('/whatsapp/automatico', { method: 'PUT', body: JSON.stringify({ ligado, turmas }) });
        if (r.status !== 'ok') throw new Error(r.mensagem);
        notificar.ok(r.mensagem);
        await carregarEnvio(true);
      } catch (erro) {
        botao.disabled = false;
        if (erro.message !== 'Sessão expirada') Swal.fire({ title: 'Não foi possível salvar', text: erro.message, icon: 'error' });
      }
    }

    document.getElementById('areaControle').addEventListener('change', (evento) => {
      if (evento.target.name === 'escopoTurmas') {
        document.getElementById('listaTurmasEscolha').hidden = evento.target.value === 'todas';
      }
    });

    document.getElementById('areaControle').addEventListener('click', async (evento) => {
      const alvo = evento.target.closest('button');
      if (!alvo) return;

      if (alvo.id === 'btnLigarAutomatico') {
        const turmas = turmasDoFormulario();
        const confirmacao = await Swal.fire({
          title: 'Ligar o envio automático?',
          text: `A partir de agora este número manda mensagem sozinho para os alunos que entrarem em risco ${turmas ? `em ${turmas.length} turma(s)` : 'em todas as turmas'}, sem ninguém conferir a lista antes.`,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: 'Ligar',
          cancelButtonText: 'Cancelar'
        });
        if (confirmacao.isConfirmed) salvarAutomatico(true, alvo);
      } else if (alvo.id === 'btnSalvarTurmas') {
        salvarAutomatico(true, alvo);
      } else if (alvo.id === 'btnDesligarAutomatico') {
        const confirmacao = await Swal.fire({
          title: 'Desligar o envio automático?',
          text: 'Nenhuma mensagem nova sai. Quem estava na fila não recebe; se ainda estiver em risco quando ligar de novo, volta para a fila.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'Desligar',
          confirmButtonColor: '#dc3545',
          cancelButtonText: 'Continuar ligado'
        });
        if (confirmacao.isConfirmed) salvarAutomatico(false, alvo);
      }
    });

    document.getElementById('envioConexao').addEventListener('click', async (evento) => {
      if (evento.target.closest('#btnRetomar')) {
        try {
          const r = await chamarApi('/whatsapp/sessao/retomar', { method: 'POST' });
          if (r.status !== 'ok') throw new Error(r.mensagem);
          notificar.ok('Envio retomado.');
          carregarEnvio();
        } catch (erro) {
          if (erro.message !== 'Sessão expirada') Swal.fire({ title: 'Não foi possível retomar', text: erro.message, icon: 'error' });
        }
      }
    });

    // ───────────── Histórico ─────────────

    let paginaHistorico = 1;
    let usuariosHistoricoPreenchidos = false;

    async function carregarHistorico(pagina = 1) {
      const tabela = document.getElementById('tabelaHistorico');
      tabela.innerHTML = '<tr><td colspan="5" class="text-center text-body-secondary py-4">Carregando...</td></tr>';
      const params = new URLSearchParams({ pagina });
      const turma = document.getElementById('historicoTurma').value;
      const usuario = document.getElementById('historicoUsuario').value;
      const status = document.getElementById('historicoStatus').value;
      if (turma) params.set('turma', turma);
      if (usuario) params.set('usuario', usuario);
      if (status) params.set('status', status);

      try {
        const r = await chamarApi(`/whatsapp/mensagens?${params}`);
        if (r.status !== 'ok') throw new Error(r.mensagem);
        paginaHistorico = r.pagina;

        if (!usuariosHistoricoPreenchidos) {
          const select = document.getElementById('historicoUsuario');
          r.usuarios.forEach((u) => select.insertAdjacentHTML('beforeend', `<option value="${u.id}">${escaparHtml(u.nome)}</option>`));
          usuariosHistoricoPreenchidos = true;
        }

        tabela.innerHTML = r.dados.length === 0
          ? '<tr><td colspan="5" class="text-center text-body-secondary py-4">Nenhuma mensagem encontrada.</td></tr>'
          : r.dados.map((m) => `
            <tr>
              <td class="small text-nowrap">${formatarDataHora(m.enviadaEm || m.atualizadoEm)}</td>
              <td>${escaparHtml(m.nomeAluno || '—')}<div class="small text-body-secondary">${escaparHtml(m.matricula)}</div></td>
              <td class="small">${escaparHtml(nomeTurmaLimpo(m.nomeTurma) || m.codigoTurma)}</td>
              <td class="small">${escaparHtml(m.enviadoPor)}${m.numero ? `<div class="text-body-secondary">${formatarTelefone(m.numero)}${m.tipoNumero === 'institucional' ? ' · chip da escola' : ''}</div>` : ''}</td>
              <td>${badgeMensagem(m.status, m.erro)}</td>
            </tr>`).join('');

        document.getElementById('historicoResumo').textContent = `${r.total} mensagem(ns) · página ${r.pagina} de ${r.paginas}`;
        document.getElementById('historicoAnterior').disabled = r.pagina <= 1;
        document.getElementById('historicoProxima').disabled = r.pagina >= r.paginas;
      } catch (erro) {
        if (erro.message !== 'Sessão expirada') {
          tabela.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-4">Não foi possível carregar: ${escaparHtml(erro.message)}</td></tr>`;
        }
      }
    }

    // O histórico é consulta do que já foi enviado: turma encerrada precisa
    // continuar filtrável, mesmo não recebendo mais mensagem.
    preencherSelectTurmas(document.getElementById('historicoTurma'), chamarApi, true);
    document.getElementById('formHistorico').addEventListener('submit', (evento) => {
      evento.preventDefault();
      carregarHistorico(1);
    });
    document.getElementById('historicoAnterior').addEventListener('click', () => carregarHistorico(paginaHistorico - 1));
    document.getElementById('historicoProxima').addEventListener('click', () => carregarHistorico(paginaHistorico + 1));

    // ───────────── Abas ─────────────

    // Cada aba carrega na primeira vez que é aberta; envio e histórico recarregam
    // sempre, porque outras pessoas mexem nesses dados ao mesmo tempo.
    const abasCarregadas = new Set();

    function abrirAba(nome) {
      const abas = ['numero', 'mensagem', 'envio', 'historico'];
      if (!abas.includes(nome)) nome = 'numero';

      document.querySelectorAll('#abas [data-aba]').forEach((link) => link.classList.toggle('active', link.dataset.aba === nome));
      document.querySelectorAll('[data-painel]').forEach((painel) => { painel.hidden = painel.dataset.painel !== nome; });

      // A consulta a cada 15s só roda com a aba Envio automático aberta.
      if (nome === 'envio') iniciarAtualizacaoEnvio();
      else pararAtualizacaoEnvio();

      if (nome === 'historico') {
        carregarHistorico(1);
      } else if (!abasCarregadas.has(nome)) {
        if (nome === 'numero') acompanharSessao();
        if (nome === 'mensagem') carregarConfig();
      }
      abasCarregadas.add(nome);
    }

    function irParaAba(nome) {
      history.replaceState(null, '', `#${nome}`);
      abrirAba(nome);
    }

    document.getElementById('abas').addEventListener('click', (evento) => {
      const link = evento.target.closest('[data-aba]');
      if (!link) return;
      evento.preventDefault();
      irParaAba(link.dataset.aba);
    });

    // Links dentro do conteúdo que levam pra outra aba ("conecte na aba Meu número").
    document.addEventListener('click', (evento) => {
      const link = evento.target.closest('[data-ir-aba]');
      if (!link) return;
      evento.preventDefault();
      irParaAba(link.dataset.irAba);
    });

    abrirAba(location.hash.slice(1));
  </script>
</body>

</html>
