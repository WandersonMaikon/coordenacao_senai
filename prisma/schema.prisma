// This is your Prisma schema file
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// ─────────────────────────────────────────
// Tabela de usuários da coordenação com acesso ao painel
// ─────────────────────────────────────────
model Usuario {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique @db.VarChar(50)
  senhaHash String   @map("senha_hash") @db.VarChar(255)
  nome      String?  @db.VarChar(255)
  // Só o admin pode ver/cadastrar usuários na tela /usuarios — os demais
  // logins da coordenação são operacionais, sem acesso a essa gestão.
  admin     Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  whatsappSessao WhatsappSessao?
  turmasWhatsapp UsuarioTurma[]

  @@map("usuarios")
}

// ─────────────────────────────────────────
// Número de WhatsApp de cada usuário da coordenação, conectado no OpenWA
// (container openwa_retencao). Um número por usuário: pessoal ou chip da escola.
// ─────────────────────────────────────────
model WhatsappSessao {
  id                Int       @id @default(autoincrement())
  usuarioId         Int       @unique @map("usuario_id")
  // Número que o usuário cadastrou (só dígitos, sem o 55). É com ele que o
  // número realmente conectado no QR é conferido — ler o QR com outro celular
  // pausa o envio.
  telefone          String?   @db.VarChar(20)
  // O que o OpenWA reportou depois de conectar (formato dele, com 55).
  telefoneConectado String?   @map("telefone_conectado") @db.VarChar(20)
  tipo              String    @default("pessoal") @db.VarChar(20) // pessoal | institucional
  // id da sessão no OpenWA (uuid). null = nunca conectou ou trocou de número.
  sessionId         String?   @map("session_id") @db.VarChar(64)
  // Último status visto no OpenWA — só cache pra tela, a fonte é o OpenWA.
  status            String?   @db.VarChar(30)
  mensagemModelo    String?   @map("mensagem_modelo") @db.Text
  intervaloMinSeg   Int       @default(90) @map("intervalo_min_seg")
  intervaloMaxSeg   Int       @default(180) @map("intervalo_max_seg")
  limiteDia         Int       @default(25) @map("limite_dia")
  limiteMes         Int       @default(500) @map("limite_mes")
  janelaInicio      String    @default("08:00") @map("janela_inicio") @db.VarChar(5)
  janelaFim         String    @default("19:00") @map("janela_fim") @db.VarChar(5)
  // Preenchido quando o sistema para os envios sozinho (número desconectado,
  // número diferente do cadastrado, erros seguidos). null = pode enviar.
  pausadoMotivo     String?   @map("pausado_motivo") @db.VarChar(255)
  // Erros seguidos no envio; no 3º o sistema pausa o número. Zera a cada sucesso.
  falhasSeguidas    Int       @default(0) @map("falhas_seguidas")
  // Primeira vez que este número ficou pronto — base do "aquecimento" (limite
  // menor nos primeiros dias de um número novo).
  conectadoEm       DateTime? @map("conectado_em")
  // Número do sistema: manda sozinho para os alunos em risco da escola inteira
  // (src/services/whatsappAutomatico.js). Só um número pode estar ligado — quem
  // garante é o PUT /whatsapp/automatico, não o banco.
  envioAutomatico   Boolean   @default(false) @map("envio_automatico")
  // Turmas do envio automático, em JSON (["APT-TST-I-0010", ...]). null = todas.
  // Existe pro piloto: começar por poucas turmas e abrir depois.
  turmasAutomatico  String?   @map("turmas_automatico") @db.Text
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("whatsapp_sessoes")
}

// ─────────────────────────────────────────
// NÃO É MAIS USADA (desde 22/10/2026): era o "assumir turma" da tela /whatsapp,
// substituído pelo envio automático do número do sistema
// (WhatsappSessao.envioAutomatico). Fica no schema porque a tabela existe em
// produção — tirar daqui sem uma migration que a apague criaria drift.
// Era: turmas que cada usuário assumiu; codigoTurma único = um responsável só.
// ─────────────────────────────────────────
model UsuarioTurma {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  codigoTurma String   @unique @map("codigo_turma") @db.VarChar(50)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("usuario_turmas")
}

// ─────────────────────────────────────────
// A fila de um número. As mensagens saem uma a uma pelo worker
// (src/services/whatsappEnvio.js), respeitando intervalo, janela e limites do
// número. Hoje só existe o lote automático do número do sistema; os lotes
// manuais antigos ("Iniciar envio") ficam no banco como histórico.
// ─────────────────────────────────────────
model LoteWhatsapp {
  id             Int       @id @default(autoincrement())
  sessaoId       Int       @map("sessao_id")
  usuarioId      Int       @map("usuario_id")
  status         String    @default("em_andamento") @db.VarChar(20) // em_andamento | parado | concluido
  // Lote do envio automático: fica em andamento enquanto a chave estiver ligada e
  // recebe alunos novos sozinho; não "conclui" quando a fila esvazia.
  automatico     Boolean   @default(false)
  total          Int
  // Por que o lote está esperando agora ("Limite do dia atingido — retoma..."),
  // escrito pelo worker pra tela mostrar. null = enviando normalmente.
  aguardando     String?   @db.VarChar(255)
  proximoEnvioEm DateTime? @map("proximo_envio_em")
  paradoPor      String?   @map("parado_por") @db.VarChar(255)
  iniciadoEm     DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm   DateTime? @map("finalizado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  @@index([sessaoId, status])
  @@map("lotes_whatsapp")
}

// ─────────────────────────────────────────
// Uma mensagem automática pra um aluno. Único por (matrícula, turma, primeiraFalta,
// tentativa): até duas mensagens por episódio de risco. Cancelada ou falha temporária pode voltar pra
// fila num lote novo (a mesma linha é reaproveitada); enviada nunca.
// ─────────────────────────────────────────
model MensagemWhatsapp {
  id              Int       @id @default(autoincrement())
  loteId          Int       @map("lote_id")
  sessaoId        Int       @map("sessao_id")
  usuarioId       Int       @map("usuario_id")
  matricula       String    @db.VarChar(20)
  nomeAluno       String?   @map("nome_aluno") @db.VarChar(255)
  codigoTurma     String    @map("codigo_turma") @db.VarChar(50)
  nomeTurma       String?   @map("nome_turma") @db.VarChar(255)
  // dd/mm/aaaa, igual a lancamentos.data_aula — identifica o episódio de risco.
  primeiraFalta   String    @map("primeira_falta") @db.VarChar(20)
  // 1 = primeira mensagem do episódio; 2 = a segunda, 7 dias depois, se o aluno
  // não respondeu e continua faltando (whatsappAutomatico.js). Não há 3ª.
  tentativa       Int       @default(1)
  telefone        String    @db.VarChar(20)
  texto           String    @db.Text
  // pendente | enviando | enviada | entregue | lida | falhou | cancelada
  status          String    @default("pendente") @db.VarChar(20)
  erro            String?   @db.VarChar(255)
  // Falha que não adianta repetir (número sem WhatsApp, envio interrompido que
  // pode ter saído) — o aluno não volta pra fila sozinho.
  falhaDefinitiva Boolean   @default(false) @map("falha_definitiva")
  chatId          String?   @map("chat_id") @db.VarChar(64)
  messageId       String?   @map("message_id") @db.VarChar(191)
  contatoId       Int?      @map("contato_id")
  enviadaEm       DateTime? @map("enviada_em")
  // Em que ponto está a conversa do robô com o aluno depois desta mensagem
  // (whatsappConversa.js): null = ninguém respondeu ainda; "humano" = alguém da
  // coordenação escreveu à mão e o robô ficou quieto.
  conversaEtapa      String?  @map("conversa_etapa") @db.VarChar(30)
  conversaTurnos     Int      @default(0) @map("conversa_turnos")
  conversaPediuTexto Boolean  @default(false) @map("conversa_pediu_texto")
  // Leitura da conversa inteira pela IA local (iaLocal.analisarConversa), para a
  // /contatar: resumo para a observação, a situação e o motivo — este só quando
  // a IA e o dicionário concordam (null = sem certeza, a pessoa escolhe).
  conversaResumo      String?   @map("conversa_resumo") @db.Text
  conversaSituacao    String?   @map("conversa_situacao") @db.VarChar(20)
  conversaMotivo      String?   @map("conversa_motivo") @db.VarChar(50)
  // O motivo que a IA leu, com ou sem certeza: só serve de conferência (ex.: o
  // "assunto delicado" da /contatar exige a IA e o dicionário de acordo).
  conversaMotivoIa    String?   @map("conversa_motivo_ia") @db.VarChar(50)
  conversaAnalisadaEm DateTime? @map("conversa_analisada_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@unique([matricula, codigoTurma, primeiraFalta, tentativa])
  @@index([loteId, status])
  @@index([sessaoId, enviadaEm])
  @@index([usuarioId])
  @@map("mensagens_whatsapp")
}

// ─────────────────────────────────────────
// Mensagem que CHEGOU pelo webhook do OpenWA (a resposta do aluno). A
// MensagemWhatsapp acima é a saída; esta é a volta.
//
// Existe como tabela própria por dois motivos. Idempotência: `messageId` é único,
// e é ele que impede uma reentrega do gateway de virar dois registros (mesmo
// cuidado do upsert em POST /webhook/frequencia). E afinação: sem o log do que
// chegou e de como foi interpretado, não há como melhorar o dicionário de
// palavras-chave depois.
//
// Guarda inclusive o que foi ignorado (mensagem nossa, grupo) e o que veio de
// número desconhecido (matricula null) — é o que permite entender "por que essa
// resposta não virou contato?".
// ─────────────────────────────────────────
model RespostaWhatsapp {
  id             Int      @id @default(autoincrement())
  messageId      String   @unique @map("message_id") @db.VarChar(191)
  chatId         String   @map("chat_id") @db.VarChar(64)
  // Normalizado, só dígitos sem o 55 — mesmo formato de alunos.telefone.
  telefone       String?  @db.VarChar(20)
  // null = número que não casou com nenhuma mensagem enviada.
  matricula      String?  @db.VarChar(20)
  mensagemId     Int?     @map("mensagem_id")
  contatoId      Int?     @map("contato_id")
  texto          String   @db.Text
  // menu | palavras_chave | promessa | desistencia | pediu_ajuda | recusou_ajuda |
  // sair | nao_entendido | ignorada | sem_vinculo
  interpretacao  String   @db.VarChar(20)
  motivoSugerido String?  @map("motivo_sugerido") @db.VarChar(50)
  // O que o robô respondeu a esta mensagem (whatsappConversa.js); null = ficou quieto.
  respostaRobo   String?  @map("resposta_robo") @db.Text
  recebidaEm     DateTime @map("recebida_em")
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@index([matricula])
  @@index([chatId])
  @@map("respostas_whatsapp")
}

// ─────────────────────────────────────────
// Tabela principal: lançamentos de frequência
// vindos do Tampermonkey instalado nos professores
// ─────────────────────────────────────────
model Lancamento {
  id             Int      @id @default(autoincrement())
  matricula      String   @db.VarChar(20)
  nomeAluno      String?  @map("nome_aluno") @db.VarChar(255)
  dataAula       String?  @map("data_aula") @db.VarChar(20)
  idAula         String?  @map("id_aula") @db.VarChar(50)
  codigoTurma    String?  @map("codigo_turma") @db.VarChar(50)
  nomeTurma      String?  @map("nome_turma") @db.VarChar(255)
  uc             String   @default("") @db.VarChar(255)
  periodoLetivo  String?  @map("periodo_letivo") @db.VarChar(20)
  professor      String?  @db.VarChar(255)
  qtdFaltas      Int      @default(1) @map("qtd_faltas")
  // NÃO USADA HOJE. Sobrou de uma tela de frequência (% de aulas presentes) que
  // foi revertida: nenhum código escreve nem lê essa coluna, e o userscript
  // voltou a não enviar o total de aulas do dia.
  // A coluna fica porque a migration já rodou em produção — removê-la do schema
  // sem dropar do banco (ou vice-versa) cria drift no próximo `migrate dev`.
  // Se a tela de frequência voltar, é aqui que o denominador da % entra.
  qtdAulas       Int?     @map("qtd_aulas")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")
  // Relacionamento opcional com a tabela de Alunos (preparando o futuro)
  aluno   Aluno? @relation(fields: [matricula], references: [matricula])

  // Evita duplicar o mesmo lançamento (mesmo aluno, mesmo dia, mesma turma, mesma UC).
  // A UC faz parte da chave porque uma turma pode ter dois professores lançando no
  // mesmo dia: sem ela, o segundo a salvar sobrescrevia a falta lançada pelo primeiro.
  // Cada UC tem sua própria linha, e a soma do dia é feita na leitura.
  @@unique([matricula, dataAula, codigoTurma, uc], name: "chave_idempotencia")
  // relationMode = "prisma" não cria índice automático para FK — criamos manualmente
  @@index([matricula])
  @@map("lancamentos")
}

// ─────────────────────────────────────────
// Tabela de Alunos — você vai popular isso com
// o Excel que a secretaria te manda (telefone, etc.)
// Já deixei pronta pra você não precisar migrar depois
// ─────────────────────────────────────────
model Aluno {
  matricula   String   @id @db.VarChar(20)
  nome        String?  @db.VarChar(255)
  telefone    String?  @db.VarChar(20)
  cpf         String?  @db.VarChar(20)
  nascimento  DateTime?
  situacao    String?  @db.VarChar(50)
  // Respondeu SAIR no WhatsApp: não recebe mais mensagem automática nenhuma.
  whatsappOptOut Boolean @default(false) @map("whatsapp_opt_out")
  // Telefone corrigido na mão pela tela /telefones. Enquanto preenchido, a
  // importação da planilha não sobrescreve o telefone: a planilha da secretaria
  // costuma estar mais velha que a correção que a coordenação acabou de fazer.
  telefoneEditadoEm  DateTime? @map("telefone_editado_em")
  telefoneEditadoPor String?   @map("telefone_editado_por") @db.VarChar(100)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  lancamentos Lancamento[]
  contatos    Contato[]

  @@map("alunos")
}

// ─────────────────────────────────────────
// Tabela de Contatos — registro de quando a coordenação
// entrou em contato com o aluno (WhatsApp, ligação, etc.)
// Ainda não usada agora, mas a estrutura já fica pronta
// ─────────────────────────────────────────
model Contato {
  id          Int      @id @default(autoincrement())
  matricula   String   @db.VarChar(20)
  canal       String?  @db.VarChar(50)   // ex: "whatsapp", "ligacao", "presencial"
  status      String?  @db.VarChar(50)   // ex: "respondido", "sem_resposta", "acompanhar", "nunca_contato", "recuperado"
  motivo      String?  @db.VarChar(50)   // ex: "transporte", "trabalho", "saude", "financeiro", "desmotivacao_curso", "problema_familiar", "outro"
  // Motivo deduzido da resposta do aluno no WhatsApp, esperando confirmação da
  // coordenação na /risco. Sugestão pendente = motivoSugerido != null && motivo == null.
  // Fica separado de `motivo` de propósito: `motivo` alimenta o gráfico do painel,
  // que é o indicador levado à diretoria — só gente escreve nele.
  motivoSugerido String? @map("motivo_sugerido") @db.VarChar(50)
  // Como a sugestão surgiu: "menu" (o aluno digitou o número) ou "palavras_chave"
  // (o sistema deduziu do texto). A tela mostra os dois diferente — um é o aluno
  // dizendo, o outro é o sistema achando.
  sugeridoPor String?   @map("sugerido_por") @db.VarChar(20)
  observacao  String?  @db.Text
  contatadoPor String? @map("contatado_por") @db.VarChar(255)
  criadoEm    DateTime @default(now()) @map("criado_em")
  // O histórico é editável pela tela de risco (PUT /contatos/:id). criadoEm continua
  // sendo a data do contato em si; atualizadoEm mostra que o registro foi corrigido.
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  aluno Aluno @relation(fields: [matricula], references: [matricula])

  @@index([matricula])
  @@map("contatos")
}

// ─────────────────────────────────────────
// Caso encerrado pela coordenação na tela /recuperado: o aluno some do risco e do
// acompanhamento **mesmo continuando a faltar**, até alguém reabrir. Existe porque
// há situações que o sistema não tem como saber que estão resolvidas (aluno mudou
// de turma, trancou, combinou reposição, a família explicou a ausência).
//
// Reabrir apaga a linha — o histórico fica nos `Contato` que a marcação e a
// reabertura criam, então não se perde quem fez o quê.
// ─────────────────────────────────────────
model CasoResolvido {
  id           Int      @id @default(autoincrement())
  matricula    String   @db.VarChar(20)
  codigoTurma  String   @map("codigo_turma") @db.VarChar(50)
  nomeAluno    String?  @map("nome_aluno") @db.VarChar(255)
  nomeTurma    String?  @map("nome_turma") @db.VarChar(255)
  motivo       String?  @db.VarChar(50)
  observacao   String?  @db.Text
  resolvidoPor String?  @map("resolvido_por") @db.VarChar(255)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@unique([matricula, codigoTurma])
  @@map("casos_resolvidos")
}

// ─────────────────────────────────────────
// Turma encerrada pela coordenação (tela /painel). Turma que terminou o semestre
// nunca para de aparecer sozinha: os alunos ficam com a sequência de faltas em
// aberto no último dia de aula e nada mais vai fechá-la, porque não haverá mais
// chamada. Encerrar tira a turma do trabalho do dia a dia (risco, faltas, painel,
// WhatsApp) **sem apagar nada** — lançamentos e contatos continuam no banco e
// voltam a aparecer com ?incluirEncerradas=1 ou filtrando a turma direto.
//
// Reabrir apaga a linha: a turma volta a ser avaliada normalmente.
// ─────────────────────────────────────────
model TurmaEncerrada {
  id           Int      @id @default(autoincrement())
  codigoTurma  String   @unique @map("codigo_turma") @db.VarChar(50)
  nomeTurma    String?  @map("nome_turma") @db.VarChar(255)
  motivo       String?  @db.VarChar(50)
  observacao   String?  @db.Text
  encerradaPor String?  @map("encerrada_por") @db.VarChar(255)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("turmas_encerradas")
}

// ─────────────────────────────────────────
// Decisão da coordenação sobre uma possível FALTA COLETIVA: mais da metade de
// uma turma entrou em risco no mesmo dia de aula (feriado emendado, evento da
// escola, chuva, ônibus). O envio automático segura a 1ª mensagem desses alunos
// até alguém decidir (whatsappAutomatico.js):
//   enviar     — não foi coletivo, as mensagens saem normalmente;
//   nao_enviar — foi evento da turma: essa falta não gera mensagem.
// Sem linha = ainda não decidido. Nos dois casos (e também sem decisão), quem
// faltar de novo numa aula seguinte volta a receber: aí não é mais o evento.
// ─────────────────────────────────────────
model FaltaColetiva {
  id          Int      @id @default(autoincrement())
  codigoTurma String   @map("codigo_turma") @db.VarChar(50)
  // dd/mm/aaaa, igual a lancamentos.data_aula — o dia em que entraram em risco.
  dataAula    String   @map("data_aula") @db.VarChar(20)
  decisao     String   @db.VarChar(20) // enviar | nao_enviar
  decididoPor String   @map("decidido_por") @db.VarChar(50)
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@unique([codigoTurma, dataAula])
  @@map("faltas_coletivas")
}

// ─────────────────────────────────────────
// Quem da coordenação assumiu procurar o aluno na /contatar ("Eu cuido deste
// aluno"). Um por aluno; assumir de novo troca a pessoa. Não é apagado quando o
// caso se resolve: vale só se `assumidoEm` for depois do motivo atual do aluno
// estar na lista (precisamContato.js), então uma volta à lista meses depois não
// mostra um responsável antigo.
// ─────────────────────────────────────────
model ResponsavelContato {
  id         Int      @id @default(autoincrement())
  matricula  String   @unique @db.VarChar(20)
  usuario    String   @db.VarChar(50)
  assumidoEm DateTime @default(now()) @map("assumido_em")

  @@map("responsaveis_contato")
}

// ─────────────────────────────────────────
// Um navegador com o userscript instalado (tela /professores). Desde a versão
// 4.3, o script gera um id na primeira vez que roda (guardado no Tampermonkey
// daquela máquina) e avisa o servidor quando o SGE abre e a cada "Salvar" —
// sem nenhum dado de aluno. É o que permite saber se o script está vivo, em
// que versão, e se está falhando, coisa que os lançamentos sozinhos não dizem
// (professor sem envio pode só não ter tido aula).
// O professor é o nome digitado naquele navegador: a tela junta as linhas
// com os lançamentos pelo nome normalizado (src/services/professores.js).
// ─────────────────────────────────────────
model InstalacaoScript {
  id              Int       @id @default(autoincrement())
  instalacaoId    String    @unique @map("instalacao_id") @db.VarChar(64)
  professor       String    @default("") @db.VarChar(255)
  versao          String    @default("") @db.VarChar(20)
  navegador       String    @default("") @db.VarChar(30)
  ultimoSinalEm   DateTime  @map("ultimo_sinal_em")
  // Último POST /webhook/frequencia confirmado vindo deste navegador.
  ultimoEnvioEm   DateTime? @map("ultimo_envio_em")
  // Envios que falharam 3 vezes e esperam na fila local do navegador.
  filaPendente    Int       @default(0) @map("fila_pendente")
  filaDesde       DateTime? @map("fila_desde")
  // "Salvar" em que o script leu os alunos da tela, e em qual tela (caminho
  // do SGE com os números trocados por :n).
  ultimaCapturaEm DateTime? @map("ultima_captura_em")
  telaCaptura     String?   @map("tela_captura") @db.VarChar(200)
  // "Salvar" em que o script não achou aluno nenhum. Em outra tela do SGE é
  // normal; na mesma tela onde já capturou, é sinal de que o SGE mudou.
  semCapturaEm    DateTime? @map("sem_captura_em")
  semCapturaTela  String?   @map("sem_captura_tela") @db.VarChar(200)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@map("instalacoes_script")
}

// ─────────────────────────────────────────
// "Corrigir nome" na tela /professores. O nome do professor é o digitado em
// cada Tampermonkey, e a mesma pessoa chega escrita de formas diferentes
// ("Karla Correa" e "Karla Correia"). Corrigir faz UPDATE em lancamentos e
// instalacoes_script, e grava aqui o nome errado para o webhook trocar na
// chegada — o navegador com o nome antigo continua mandando, e sem isto o
// nome errado voltaria no próximo envio.
// `nomeDigitado` é o nome completo normalizado (sem acento/caixa/espaços
// extras) — ver nomeNormalizado em src/services/professores.js.
// ─────────────────────────────────────────
model CorrecaoNomeProfessor {
  id           Int      @id @default(autoincrement())
  nomeDigitado String   @unique @map("nome_digitado") @db.VarChar(255)
  nomeCorreto  String   @map("nome_correto") @db.VarChar(255)
  corrigidoPor String   @map("corrigido_por") @db.VarChar(50)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("correcoes_nome_professor")
}
