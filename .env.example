# Porta interna do servidor Node (não precisa mudar)
PORT=3000

# Conexão com o MySQL (host = nome do serviço no docker-compose, não localhost)
DB_HOST=mysql_retencao
DB_PORT=3306
DB_NAME=senai_retencao
DB_USER=senai_retencao
DB_PASSWORD=

# Usada pelo Prisma CLI (migrate deploy) — mesmos valores acima, formato de URL
DATABASE_URL="mysql://senai_retencao:SENHA_AQUI@mysql_retencao:3306/senai_retencao"

# Senha do usuário root do container MySQL (só usada na criação do container)
DB_ROOT_PASSWORD=

# Token do tunnel Cloudflare criado para este app (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Chave usada para assinar o token JWT do login — string longa e aleatória, só no .env
JWT_SECRET=

# WhatsApp (OpenWA, container openwa_retencao) — tela /whatsapp.
# Sem OPENWA_URL/OPENWA_API_KEY a tela abre, mas avisa que não está configurado.
# OPENWA_API_KEY: chave com papel "operator", criada com a chave admin que o
# OpenWA grava em /app/data/.api-key no primeiro start.
OPENWA_URL=http://openwa_retencao:2785/api
OPENWA_API_KEY=
# Versão (tag do GitHub) do OpenWA construída pelo docker compose
OPENWA_VERSION=v0.23.4
# Memória máxima do container (cada número conectado usa ~300-500 MB)
OPENWA_MEM_LIMIT=2g
# Versão do WhatsApp Web do motor: vazio = registro de terceiros; off = versão atual do WhatsApp.
# Use off se o número conecta mas não responde (checagem do número travando).
WWEBJS_WEB_VERSION=
# Tempo pro WhatsApp Web carregar dentro do OpenWA (ms)
WWEBJS_AUTH_TIMEOUT_MS=120000

# Webhook de entrada: é por aqui que a RESPOSTA do aluno volta pro sistema.
# A URL é a do backend na rede interna do compose (nome do serviço, porta interna):
# o tráfego openwa -> node não sai da máquina nem passa pelo tunnel Cloudflare.
# Vazio = o webhook não é registrado nas sessões e nenhuma resposta é recebida
# (o envio continua funcionando normalmente).
OPENWA_WEBHOOK_URL=http://node_retencao:3000/webhook/whatsapp
# Segredo compartilhado com o OpenWA, usado pra validar que quem chamou o webhook
# foi ele. String longa e aleatória. SEM ELE a rota responde 503 e nada é recebido
# — de propósito: webhook público sem proteção aceitaria qualquer um escrevendo no
# histórico dos alunos.
OPENWA_WEBHOOK_SECRET=

# Opcional — usado por "npm run seed-admin" (rodado a cada deploy via atualizar.sh)
# pra criar esse usuário SE ele ainda não existir. Nunca sobrescreve senha de
# usuário já existente. Pode deixar em branco depois do primeiro deploy.
SEED_ADMIN_USER=
SEED_ADMIN_PASSWORD=
