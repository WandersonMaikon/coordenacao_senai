# Porta interna do servidor Node (não precisa mudar)
PORT=3000

# Conexão com o MySQL (host = nome do serviço no docker-compose, não localhost)
DB_HOST=mysql_retencao
DB_PORT=3306
DB_NAME=senai_retencao
DB_USER=senai_retencao
DB_PASSWORD=

# Usada pelo Prisma CLI (migrate deploy) — mesmos valores acima, formato de URL
DATABASE_URL="mysql://senai_retencao:SENHA_AQUI@mysql_retencao:3306/senai_retencao"

# Senha do usuário root do container MySQL (só usada na criação do container)
DB_ROOT_PASSWORD=

# Token do tunnel Cloudflare criado para este app (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Chave usada para assinar o token JWT do login — string longa e aleatória, só no .env
JWT_SECRET=
